---
// src/components/About.astro
import { Image } from 'astro:assets';
import profileImg from '../assets/jak.png';

const skills = [
  'Astro & React',
  'WordPress & WooCommerce',
  'SaaS & Multitenant',
  'Figma (UI/UX)',
  'Automações & Webhooks',
  'JavaScript & TypeScript',
  'HTML5 & Tailwind CSS',
  'SEO & Performance'
];

const stats = [
  { value: 'ADS', label: 'Graduação Superior' },
  { value: 'SaaS + Web', label: 'Sistemas Próprios' },
  { value: 'Direto', label: 'Sem Intermediários' },
];
---

<section id="sobre" class="py-16 md:py-24 relative overflow-hidden bg-bg-dark/60">
  <!-- Brilho de fundo sutil -->
  <div class="absolute bottom-0 left-0 w-87.5 h-87.5 bg-accent/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>
  <div class="absolute top-1/2 right-0 w-62.5 h-62.5 bg-primary/10 blur-[100px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
     <!-- COLUNA DA ESQUERDA: FOTO DE PERFIL -->
<div class="lg:col-span-5 relative flex justify-center">
  <div class="relative w-full max-w-sm sm:max-w-md group">
    
    <!-- EFEITO DE BRILHO / GLOW ROXO ATRÁS DA FOTO -->
    <div class="absolute inset-0 bg-linear-to-tr from-primary/40 via-accent/30 to-purple-dark/50 rounded-2xl blur-2xl transform group-hover:scale-105 transition-all duration-500 -z-10"></div>
    
    <!-- Container da foto (Sem borda) -->
    <div class="relative rounded-2xl overflow-hidden bg-transparent shadow-2xl">
      <Image
        src={profileImg}
        alt="Jaqueline Souza - Desenvolvedora e Criadora de Soluções Digitais"
        class="w-full object-cover object-center rounded-2xl group-hover:scale-105 transition-transform duration-500"
      />
    </div>

    <!-- Card Flutuante de formação/experiência -->
    <div class="absolute -bottom-5 -right-2 sm:-right-4 bg-bg-dark/95 backdrop-blur-md border border-accent/40 text-white p-3.5 rounded-xl shadow-2xl hidden sm:flex items-center gap-3 z-10">
      <div class="w-10 h-10 rounded-lg bg-accent/20 border border-accent/30 flex items-center justify-center text-accent shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
        </svg>
      </div>
      <div>
        <p class="font-heading font-bold text-xs text-white">Análise e Dev. de Sistemas</p>
        <p class="font-body text-[11px] text-gray-light">Desenvolvedora Web & SaaS</p>
      </div>
    </div>

  </div>
</div>
      <!-- COLUNA DA DIREITA: CONTEÚDO E TEXTOS -->
      <div class="lg:col-span-7">
        
        <!-- TAG SUPERIOR -->
        <span class="inline-block font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60 mb-3">
          Sobre Mim
        </span>

        <!-- TÍTULO -->
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-5 leading-tight">
          A engenharia técnica por trás do seu projeto
        </h2>

        <!-- TEXTO DE APRESENTAÇÃO -->
        <div class="space-y-3 font-body text-gray-light text-sm sm:text-base leading-relaxed mb-6">
          <p>
            Prazer, sou <strong class="text-white font-semibold">Jaqueline Souza</strong>. Sou graduada em <strong class="text-white font-semibold">Análise e Desenvolvimento de Sistemas</strong> e atuo unindo código de alta performance, design e foco em conversão.
          </p>
          <p>
            Desenvolvo <strong class="text-white font-semibold">Sites Institucionais, Landing Pages e Lojas Virtuais</strong> de alta velocidade, além de criar produtos próprios como o <strong class="text-accent font-semibold">Foxped</strong> (SaaS de cardápio digital) e estruturas dinâmicas de <strong class="text-white font-semibold">Links na Bio</strong>. Atendo cada projeto de forma dedicada, sem intermediários.
          </p>
        </div>

        <!-- CARDS DE ESTATÍSTICAS / DIFERENCIAIS -->
        <div class="grid grid-cols-3 gap-3 mb-6">
          {stats.map((stat) => (
            <div class="bg-purple-dark/20 border border-purple-dark/50 rounded-xl p-3 text-center">
              <span class="block font-heading font-extrabold text-sm sm:text-lg text-accent mb-0.5">
                {stat.value}
              </span>
              <span class="font-body text-[11px] text-gray-light leading-snug block">
                {stat.label}
              </span>
            </div>
          ))}
        </div>

        <!-- TAGS DE TECNOLOGIAS E HABILIDADES -->
        <div class="mb-8">
          <p class="font-heading text-xs uppercase tracking-wider text-purple-light mb-2.5 font-semibold">
            Especialidades & Tecnologias:
          </p>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="bg-purple-dark/30 border border-purple-dark/60 text-gray-light hover:text-white hover:border-accent/60 font-body text-xs px-3 py-1 rounded-lg transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- BOTÃO PORTFÓLIO -->
        <div>
          <a
            href="#projetos"
            class="inline-flex items-center gap-2.5 bg-primary hover:bg-accent text-white font-heading font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl shadow-lg shadow-primary/20 hover:shadow-accent/30 hover:-translate-y-0.5 transition-all duration-300"
          >
            Ver Projetos Desenvolvidos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>