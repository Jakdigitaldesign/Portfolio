---
// src/components/About.astro
import { Image } from 'astro:assets';
import profileImg from '../assets/jake.webp';

const skills = [
  'Astro',
  'WordPress & WooCommerce',
  'SaaS & Multitenant',
  'Figma (UI/UX)',
  'Automação & Webhooks',
  'JavaScript & Node.js',
  'HTML5 & CSS3',
  'SEO & Performance'
];

const stats = [
  { value: 'ADS', label: 'Formação Superior' },
  { value: 'SaaS + Web', label: 'Projetos Próprios' },
  { value: '100%', label: 'Foco em Vendas' },
];
---

<section id="sobre" class="py-20 md:py-28 relative overflow-hidden bg-bg-dark/60">
  <!-- Brilho de fundo sutil -->
  <div class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-accent/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>
  <div class="absolute top-1/2 right-0 w-[250px] h-[250px] bg-primary/10 blur-[100px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- COLUNA DA ESQUERDA: FOTO DE PERFIL -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-sm sm:max-w-md group">
          
          <!-- Moldura decorativa de fundo com gradiente -->
          <div class="absolute -inset-3 bg-gradient-to-tr from-primary via-accent to-purple-dark rounded-3xl blur-md opacity-70 group-hover:opacity-100 transition duration-700"></div>
          
          <!-- Container da foto -->
          <div class="relative rounded-2xl overflow-hidden border-2 border-purple-dark/80 bg-bg-dark shadow-2xl">
            <Image
              src={profileImg}
              alt="Jaqueline Souza - Desenvolvedora e Criadora de Soluções Digitais"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Card Flutuante de formação/experiência -->
          <div class="absolute -bottom-6 -right-2 sm:-right-6 bg-bg-dark/95 backdrop-blur-md border border-accent/40 text-white p-4 rounded-xl shadow-2xl hidden sm:flex items-center gap-3.5 z-10">
            <div class="w-11 h-11 rounded-lg bg-accent/20 border border-accent/30 flex items-center justify-center text-accent shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
              </svg>
            </div>
            <div>
              <p class="font-heading font-bold text-sm text-white">Análise e Dev. de Sistemas</p>
              <p class="font-body text-xs text-gray-light">Graduada & Especialista Web</p>
            </div>
          </div>

        </div>
      </div>

      <!-- COLUNA DA DIREITA: CONTEÚDO E TEXTOS -->
      <div class="lg:col-span-7">
        
        <!-- TAG SUPERIOR -->
        <span class="inline-block font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60 mb-4">
          Sobre mim
        </span>

        <!-- TÍTULO -->
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-6 leading-tight">
          Quem está por trás do seu projeto
        </h2>

        <!-- TEXTOS DE APRESENTAÇÃO (DIRETOS E RELEVANTES) -->
        <div class="space-y-4 font-body text-gray-light text-base sm:text-lg leading-relaxed mb-8">
          <p>
            Prazer, sou <strong class="text-white font-semibold">Jaqueline Souza</strong>! Graduada em <strong class="text-white font-semibold">Análise e Desenvolvimento de Sistemas</strong>, unindo design estratégico e tecnologia para criar soluções digitais que convertem visitantes em clientes.
          </p>
          <p>
            Além de projetar <strong class="text-white font-semibold">Sites, Landing Pages e Lojas Virtuais</strong> de alta performance, sou idealizadora do <strong class="text-accent font-semibold">Foxped</strong> (SaaS de cardápio digital automatizado) e de projetos acessíveis como os <strong class="text-white font-semibold">Minisites e Links na Bio</strong>. Meu compromisso é entregar ferramentas prontas para gerar resultados reais e acelerar o seu negócio.
          </p>
        </div>

        <!-- CARDS DE ESTATÍSTICAS / DIFERENCIAIS -->
        <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-8">
          {stats.map((stat) => (
            <div class="bg-purple-dark/20 border border-purple-dark/50 rounded-xl p-3 sm:p-4 text-center">
              <span class="block font-heading font-extrabold text-base sm:text-xl text-accent mb-0.5">
                {stat.value}
              </span>
              <span class="font-body text-xs text-gray-light leading-snug block">
                {stat.label}
              </span>
            </div>
          ))}
        </div>

        <!-- TAGS DE TECNOLOGIAS E HABILIDADES -->
        <div class="mb-8">
          <p class="font-heading text-xs uppercase tracking-wider text-purple-light mb-3 font-semibold">
            Tecnologias & Especialidades:
          </p>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="bg-purple-dark/30 border border-purple-dark/60 text-gray-light hover:text-white hover:border-accent/60 font-body text-xs px-3 py-1.5 rounded-lg transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- BOTÃO PORTFÓLIO -->
        <div class="pt-2">
          <a
            href="/projetos"
            class="inline-flex items-center gap-3 bg-primary hover:bg-accent text-white font-heading font-bold text-sm px-8 py-4 rounded-xl shadow-lg shadow-primary/20 hover:shadow-accent/30 hover:-translate-y-0.5 transition-all duration-300"
          >
            Ver Portfólio Completo
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>