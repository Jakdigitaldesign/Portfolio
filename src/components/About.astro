---
// src/components/About.astro
import { Image } from 'astro:assets';
import profileImg from '../assets/jake.webp'; // Altere se o nome ou extensão da imagem for diferente

const skills = [
  'WordPress',
  'Elementor',
  'Figma',
  'Astro',
  'HTML5 & CSS3',
  'JavaScript',
  'Design Responsivo',
  'SEO Básico'
];
---

<section id="sobre" class="py-20 md:py-28 relative overflow-hidden">
  <!-- Brilho de fundo sutil -->
  <div class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-accent/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- COLUNA DA ESQUERDA: FOTO DE PERFIL -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-sm sm:max-w-md">
          
          <!-- Moldura decorativa de fundo com as cores da marca -->
          <div class="absolute -inset-3 bg-gradient-to-tr from-primary via-accent to-purple-dark rounded-3xl blur-md opacity-70 group-hover:opacity-100 transition duration-1000"></div>
          
          <!-- Container da foto -->
          <div class="relative rounded-2xl overflow-hidden border-2 border-purple-dark/80 bg-bg-dark shadow-2xl">
            <Image
              src={profileImg}
              alt="Jaqueline Souza - Web Designer e Desenvolvedora"
              class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Card Flutuante de formação/experiência -->
          <div class="absolute -bottom-6 -right-2 sm:-right-6 bg-purple-dark/90 backdrop-blur-md border border-accent/40 text-white p-4 rounded-xl shadow-xl hidden sm:flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center text-accent">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
              </svg>
            </div>
            <div>
              <p class="font-heading font-bold text-sm text-white">Análise e Dev. de Sistemas</p>
              <p class="font-body text-xs text-gray-light">Graduada & Especialista Web</p>
            </div>
          </div>

        </div>
      </div>

      <!-- COLUNA DA DIREITA: CONTEÚDO E TEXTOS -->
      <div class="lg:col-span-7">
        
        <!-- TAG SUPERIOR -->
        <span class="font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60">
          Sobre mim
        </span>

        <!-- TÍTULO -->
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-4 mb-6 leading-tight">
          Quem está por trás do seu site
        </h2>

        <!-- TEXTOS DE APRESENTAÇÃO -->
        <div class="space-y-4 font-body text-gray-light text-base sm:text-lg leading-relaxed mb-8">
          <p>
            Meu nome é <strong class="text-white font-semibold">Jaqueline Souza</strong>, sou web designer e desenvolvedora WordPress, formada em <strong class="text-white font-semibold">Análise e Desenvolvimento de Sistemas</strong>, com foco em criar sites profissionais, modernos e estratégicos para pequenos negócios e profissionais que desejam se destacar no digital.
          </p>
          <p>
            Meu trabalho vai além do visual: desenvolvo landing pages e sites pensados para gerar credibilidade, conversões e presença online consistente, sempre com design responsivo e boa experiência do usuário.
          </p>
          <p>
            Utilizo ferramentas como <span class="text-purple-light font-medium">WordPress, Elementor, Figma, HTML, CSS e JavaScript</span> para transformar ideias em soluções digitais funcionais, alinhadas aos objetivos de cada projeto.
          </p>
        </div>

        <!-- TAGS DE TECNOLOGIAS E HABILIDADES -->
        <div class="mb-8">
          <p class="font-heading text-xs uppercase tracking-wider text-purple-light mb-3 font-semibold">Tecnologias & Ferramentas:</p>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="bg-purple-dark/30 border border-purple-dark text-gray-light font-body text-xs px-3 py-1.5 rounded-lg">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- BOTÃO PORTFÓLIO -->
        <div class="pt-2">
          <a
            href="#projetos"
            class="inline-flex items-center gap-3 bg-primary hover:bg-accent text-white font-heading font-bold text-sm px-8 py-4 rounded-xl shadow-lg shadow-primary/20 hover:shadow-accent/30 transition-all duration-300"
          >
            Ver Meu Portfólio
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>