---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
}

const {
  title = "Jak Digital Design | Web Design, Landing Pages & SaaS",
  description = "Criação de sites profissionais, landing pages de alta conversão, e-commerces e o sistema Foxped para restaurantes. Alavanque sua presença online.",
  image = "/og-image.jpeg", // Coloque uma imagem de 1200x630 na pasta public
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;
---

<!-- Meta Tags Essenciais -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.png" />
<link rel="canonical" href={canonicalURL} />

<!-- Título e Descrição para o Google -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />