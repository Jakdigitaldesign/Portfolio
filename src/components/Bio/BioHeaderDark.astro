---
import type { ImageMetadata } from 'astro';
import img1 from "../../assets/biohero1.webp";
import img2 from "../../assets/biohero2.webp";

export interface SocialLink {
  platform:
    | 'website'
    | 'globe'
    | 'instagram'
    | 'facebook'
    | 'whatsapp'
    | 'threads'
    | 'youtube'
    | 'linkedin'
    | 'tiktok'
    | 'twitter'
    | 'pinterest'
    | 'telegram'
    | 'spotify'
    | 'discord'
    | 'google'
    | 'email'
    | 'link'
    | 'github'
    | 'behance'
    | 'dribbble';
  url: string;
  label?: string;
}

export interface Props {
  name: string;
  category?: string;
  subtitle?: string;
  badgeText?: string;
  statusBadge?: string;
  availabilityText?: string;
  location?: string;
  locationUrl?: string;
  manifestoText?: string;
  bio?: string;
  avatarImg: ImageMetadata | string;
  logoImg?: ImageMetadata | string;
  coverImg?: ImageMetadata | string;
  coverImages?: (ImageMetadata | string)[];
  ctaButton?: {
    label: string;
    url: string;
    iconClass?: string;
  };
  socialLinks?: SocialLink[];
}

const {
  name,
  category,
  subtitle,
  badgeText,
  statusBadge,
  location,
  locationUrl,
  manifestoText,
  bio,
  avatarImg,
  logoImg,
  coverImg,
  coverImages,
  ctaButton,
  socialLinks = []
} = Astro.props;

const displaySubtitle = category || subtitle || '';
const displayBadge = badgeText || statusBadge;
const displayBio = manifestoText || bio || '';

const avatarSrc = typeof avatarImg === 'string' ? avatarImg : avatarImg?.src;
const logoSrc = typeof logoImg === 'string' ? logoImg : logoImg?.src;
const singleCoverSrc = typeof coverImg === 'string' ? coverImg : coverImg?.src;

const defaultTechCovers: string[] = [
  img1.src,
  img2.src,
];

const resolvedCovers: string[] =
  coverImages && coverImages.length > 0
    ? coverImages.map((img) => (typeof img === 'string' ? img : img.src))
    : singleCoverSrc
      ? [singleCoverSrc]
      : defaultTechCovers;

const socialIcons: Record<string, string> = {
  website: 'fa-solid fa-globe',
  globe: 'fa-solid fa-globe',
  instagram: 'fa-brands fa-instagram',
  facebook: 'fa-brands fa-facebook-f',
  whatsapp: 'fa-brands fa-whatsapp',
  threads: 'fa-brands fa-threads',
  youtube: 'fa-brands fa-youtube',
  linkedin: 'fa-brands fa-linkedin-in',
  tiktok: 'fa-brands fa-tiktok',
  twitter: 'fa-brands fa-x-twitter',
  pinterest: 'fa-brands fa-pinterest-p',
  telegram: 'fa-brands fa-telegram',
  spotify: 'fa-brands fa-spotify',
  discord: 'fa-brands fa-discord',
  google: 'fa-brands fa-google',
  email: 'fa-solid fa-envelope',
  link: 'fa-solid fa-link',
  github: 'fa-brands fa-github',
  behance: 'fa-brands fa-behance',
  dribbble: 'fa-brands fa-dribbble'
};

const defaultLabels: Record<string, string> = {
  website: 'Site',
  globe: 'Site',
  whatsapp: 'WhatsApp',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  github: 'GitHub',
  behance: 'Behance',
  dribbble: 'Dribbble',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  email: 'E-mail'
};
---

<header class="w-full relative overflow-hidden pb-6 font-body">
  <!-- ==========================================
       CAPA CINEMATOGRÁFICA MAIS ALTA COM MOCKUPS
       ========================================== -->
  <div class="h-80 sm:h-92 w-full relative overflow-hidden flex flex-col items-center justify-between cover-fade-mask select-none bg-[#120421]">
    
    <!-- Camada 1: Slides de Mockups & Tecnologia -->
    <div id="jak-hero-fader" class="absolute inset-0 z-0 pointer-events-none">
      {resolvedCovers.map((src, idx) => (
        <img
          src={src}
          alt="Mockups e desenvolvimento web"
          loading={idx === 0 ? 'eager' : 'lazy'}
          class={`jak-hero-slide absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-1000 ease-in-out ${
            idx === 0 ? 'opacity-75 is-active' : 'opacity-0'
          }`}
        />
      ))}
    </div>

    <!-- Camada 2: Tonalização Roxa Suave -->
    <div
      class="absolute inset-0 z-1 bg-[#1b0533]/45 pointer-events-none"
      aria-hidden="true"
    ></div>

    <!-- Degradê concentrado na base para fundir com o fundo da página -->
    <div
      class="absolute inset-0 z-2 bg-linear-to-t from-bg-dark via-bg-dark/45 to-[#07020c]/30 pointer-events-none"
      aria-hidden="true"
    ></div>

    <!-- Camada 3: Brilho Ambiente Studio -->
    <div class="absolute z-2 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-56 bg-primary/25 rounded-full blur-3xl pointer-events-none"></div>

    

    <!-- Marca d'água do Logo posicionada mais acima para não colidir com o avatar centralizado -->
    {logoSrc && (
      <div class="relative z-10 flex-1 w-full flex items-center justify-center pb-24 sm:pb-28 pt-2 pointer-events-none">
        <img
          src={logoSrc}
          alt="Símbolo da marca"
          class="w-22 sm:w-22 h-auto object-contain opacity-25 brightness-125 drop-shadow-[0_4px_24px_rgba(11,4,18,0.95)] select-none"
        />
      </div>
    )}
  </div>

  <!-- ==========================================
       CARD PRINCIPAL FLUTUANTE CENTRALIZADO
       ========================================== -->
  <div class="max-w-md mx-auto px-1 -mt-16 sm:-mt-20 relative z-10">
    <div class="relative bg-[#0b0412]/85 backdrop-blur-2xl border border-primary/30 rounded-3xl p-5 sm:p-6 shadow-[0_24px_60px_rgba(15,4,28,0.85)] flex flex-col gap-4">
      
      <!-- Brilho especular fino no topo do card -->
      <div
        class="absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-accent/65 to-transparent pointer-events-none"
        aria-hidden="true"
      ></div>

      <!-- Topo Centralizado: Retrato + Informações Abaixo -->
      <div class="flex flex-col items-center text-center">
        
        <!-- Foto Retrato Vertical (3:4) Centralizada com Aura e Borda Gradiente -->
        <div class="relative -mt-22 sm:-mt-26 mb-4">
          <!-- Glow sutil atrás do avatar -->
          <div
            class="absolute -inset-2 bg-accent/25 rounded-3xl blur-xl pointer-events-none"
            aria-hidden="true"
          ></div>

          <div class="relative w-28 sm:w-32 aspect-3/4 rounded-2xl p-[1.5px] bg-linear-to-b from-accent/90 via-primary/50 to-primary/15 shadow-[0_16px_38px_rgba(58,1,112,0.75)]">
            <div class="w-full h-full rounded-[14px] overflow-hidden bg-bg-dark relative ring-1 ring-white/10">
              <img
                src={avatarSrc}
                alt={name}
                class="w-full h-full object-cover object-[center_12%]"
              />
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-[#0b0412]/85 via-[#0b0412]/25 to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>

        <!-- Informações da Marca Centralizadas -->
        <div class="flex flex-col items-center w-full">
          {displayBadge && (
            <span class="font-body inline-flex items-center gap-1.5 text-[10px] font-medium tracking-[0.18em] uppercase bg-primary/15 text-purple-light px-3 py-0.5 rounded-full w-fit mb-2.5 border border-primary/30">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              {displayBadge}
            </span>
          )}

          <h1 class="font-heading text-[26px] sm:text-[30px] font-semibold tracking-wide text-white leading-[1.08] drop-shadow-[0_2px_10px_rgba(0,0,0,0.45)]">
            {name}
          </h1>

          {displaySubtitle && (
            <div class="flex items-center justify-center gap-2.5 mt-2">
              <span class="w-4 h-[1.5px] bg-accent/80 rounded-full shrink-0"></span>
              <p class="font-body text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.2em] text-purple-light/85 leading-snug">
                {displaySubtitle}
              </p>
              <span class="w-4 h-[1.5px] bg-accent/80 rounded-full shrink-0"></span>
            </div>
          )}

          {location && (
            <a
              href={locationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body inline-flex items-center justify-center gap-1.5 text-[11px] text-purple-light/70 hover:text-accent transition-colors duration-200 mt-2 group w-fit"
              title="Ver localização"
            >
              <i class="fa-solid fa-location-dot text-accent group-hover:scale-110 transition-transform"></i>
              <span class="underline underline-offset-2">{location}</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[8px] opacity-70 group-hover:opacity-100 transition-opacity"></i>
            </a>
          )}
        </div>
      </div>

      <!-- Redes Sociais em Chips/Pills Centralizados -->
      {socialLinks.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-2 pt-0.5">
          {socialLinks.map((link) => {
            const icon = socialIcons[link.platform] || 'fa-solid fa-link';
            const labelText = link.label ?? defaultLabels[link.platform] ?? link.platform;

            return (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-medium tracking-wide bg-white/3 hover:bg-primary/20 border border-primary/25 hover:border-accent/60 text-gray-light hover:text-white transition-all duration-200 shadow-xs hover:-translate-y-0.5 active:translate-y-0"
              >
                <i class={`${icon} text-accent text-xs`}></i>
                <span class="leading-none">{labelText}</span>
              </a>
            );
          })}
        </div>
      )}

      <!-- Divisória Gradiente Minimalista -->
      <div class="my-0.5">
        <div class="h-px w-full bg-linear-to-r from-transparent via-accent/45 to-transparent"></div>
      </div>

      <!-- Manifesto / Bio em Cormorant Garamond Itálico -->
      {displayBio && (
        <div class="relative pl-2 pr-2 py-3 border border-primary/15 border-l-2 border-l-accent bg-white/2 rounded-xl flex items-start gap-1.5 text-left">
          <i class="fa-solid fa-quote-left text-accent/60 text-xs mt-1 shrink-0"></i>
          <p class="font-heading italic text-base sm:text-[14px] text-purple-light/90 leading-snug font-normal">
            {displayBio}
          </p>
        </div>
      )}

      <!-- Botão CTA Principal -->
      {ctaButton && (
        <a
          href={ctaButton.url}
          target="_blank"
          rel="noopener noreferrer"
          class="font-body w-full bg-linear-to-r from-primary to-accent hover:brightness-110 text-white font-semibold tracking-[0.18em] uppercase text-[11px] py-3.5 px-4 rounded-2xl shadow-[inset_0_1px_0_rgba(255,255,255,0.22),0_8px_24px_rgba(131,67,195,0.38)] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.3),0_12px_30px_rgba(154,70,242,0.52)] flex items-center justify-center gap-2 transition-all hover:scale-[1.01] active:scale-[0.99] group mt-0.5"
        >
          {ctaButton.iconClass && <i class={`${ctaButton.iconClass} text-sm`}></i>}
          <span>{ctaButton.label}</span>
          <i class="fa-solid fa-arrow-right text-[11px] opacity-80 group-hover:translate-x-1 transition-transform"></i>
        </a>
      )}

    </div>
  </div>
</header>

<style>
  .cover-fade-mask {
    -webkit-mask-image: linear-gradient(to bottom, black 68%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 68%, transparent 100%);
  }

  @keyframes slowPanZoom {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.07);
    }
  }

  .jak-hero-slide.is-active {
    animation: slowPanZoom 6.5s ease-out forwards;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll<HTMLImageElement>('.jak-hero-slide');
    let current = 0;

    if (slides.length > 1) {
      setInterval(() => {
        slides[current].classList.remove('opacity-75', 'is-active');
        slides[current].classList.add('opacity-0');

        current = (current + 1) % slides.length;

        slides[current].classList.remove('opacity-0');
        slides[current].classList.add('opacity-75', 'is-active');
      }, 5000);
    }
  });
</script>