---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface SocialLink {
  platform: 'whatsapp' | 'instagram' | 'linkedin' | 'website';
  url: string;
}

export interface Props {
  name: string;
  category: string;
  badgeText?: string;
  manifestoText?: string;
  avatarImg: ImageMetadata | string;
  logoImg?: ImageMetadata | string; // Prop para a tua logo
  websiteUrl?: string; // URL do teu site caso queiras passar de forma direta
  socialLinks?: SocialLink[];
}

const {
  name,
  category,
  manifestoText,
  avatarImg,
  logoImg,
  websiteUrl,
  socialLinks = []
} = Astro.props;

const avatarSrc = typeof avatarImg === 'string' ? avatarImg : avatarImg;
const logoSrc = typeof logoImg === 'string' ? logoImg : logoImg;

// Se for passado websiteUrl diretamente via Prop, adiciona ao array de socialLinks se ainda não existir
const finalSocialLinks = [...socialLinks];
if (websiteUrl && !finalSocialLinks.some((l) => l.platform === 'website')) {
  finalSocialLinks.unshift({ platform: 'website', url: websiteUrl });
}
---

<div>
  <!-- Hero Banner de Topo -->
  <div class="relative w-full h-80 overflow-hidden flex flex-col justify-between p-6">
    <!-- Glow Roxo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-70 h-70 bg-accent/30 rounded-full blur-3xl pointer-events-none z-0"></div>

    <!-- Imagem de Fundo (Avatar / Foto) -->
    <div class="absolute inset-0 z-0">
      {typeof avatarSrc === 'string' ? (
        <img src={avatarSrc} alt={name} class="w-full h-full object-contain object-top" />
      ) : (
        <Image src={avatarSrc} alt={name} class="w-full h-full object-contain object-top" />
      )}
      <div class="absolute inset-0 bg-linear-to-t from-[#09050d] via-[#09050d]/20 to-transparent"></div>
    </div>

    <!-- Topo: Badges Flutuantes + Logo -->
    <div class="relative z-10 flex justify-between items-center">
      

      <!-- Renderização da Logo no Canto Superior Direito -->
     {logoSrc && (
        <div class="w-9 h-9 rounded-full bg-black/40 backdrop-blur-md border border-accent/40 p-1 flex items-center justify-center overflow-hidden shadow-md">
          {typeof logoSrc === 'string' ? (
            <img src={logoSrc} alt={`Logo ${name}`} class="w-full h-full object-contain" />
          ) : (
            <Image src={logoSrc} alt={`Logo ${name}`} class="w-full h-full object-contain" />
          )}
        </div>
      )}
    </div>

    <!-- Nome e Categoria -->
    <div class="relative z-10 mb-1">
      <h1 class="font-heading text-3xl font-bold text-white tracking-tight leading-none mb-1 drop-shadow-md">
        {name}
      </h1>
      <p class="font-heading text-xs uppercase tracking-[0.2em] text-accent font-semibold drop-shadow">
        {category}
      </p>
    </div>
  </div>

  <!-- Manifesto + Redes Sociais -->
  <div class="px-6 pt-4 space-y-5">
    {manifestoText && (
      <div class="p-4 rounded-xl bg-purple-dark/15 border-l-2 border-accent backdrop-blur-sm">
        <p class="font-heading italic text-sm text-purple-light/70 leading-relaxed">
          "{manifestoText}"
        </p>
      </div>
    )}

    <!-- Redes Sociais & Website -->
    {finalSocialLinks.length > 0 && (
      <div class="flex gap-3 justify-center py-1">
        {finalSocialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.platform}
            class="w-10 h-10 rounded-full bg-purple-dark/30 border border-purple-dark/60 text-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
          >
            {link.platform === 'website' && (
              <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            )}
            {link.platform === 'whatsapp' && (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/></svg>
            )}
            {link.platform === 'instagram' && (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            )}
            {link.platform === 'linkedin' && (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</div>