---
import type { ImageMetadata } from 'astro';

export interface SocialLink {
  platform:
    | 'website'
    | 'globe'
    | 'instagram'
    | 'facebook'
    | 'whatsapp'
    | 'threads'
    | 'youtube'
    | 'linkedin'
    | 'tiktok'
    | 'twitter'
    | 'pinterest'
    | 'telegram'
    | 'spotify'
    | 'discord'
    | 'google'
    | 'email'
    | 'link'
    | 'github'
    | 'behance'
    | 'dribbble';
  url: string;
  label?: string;
}

export interface Props {
  name: string;
  category?: string;
  subtitle?: string;
  badgeText?: string;
  statusBadge?: string;
  location?: string;
  locationUrl?: string;
  manifestoText?: string;
  bio?: string;
  avatarImg: ImageMetadata | string;
  logoImg?: ImageMetadata | string;
  coverImg?: ImageMetadata | string;
  ctaButton?: {
    label: string;
    url: string;
    iconClass?: string;
  };
  socialLinks?: SocialLink[];
}

const {
  name,
  category,
  subtitle,
  badgeText,
  statusBadge,
  location,
  locationUrl,
  manifestoText,
  bio,
  avatarImg,
  logoImg,
  coverImg,
  ctaButton,
  socialLinks = []
} = Astro.props;

const displaySubtitle = category || subtitle || '';
const displayBadge = badgeText || statusBadge;
const displayBio = manifestoText || bio || '';

const avatarSrc = typeof avatarImg === 'string' ? avatarImg : avatarImg?.src;
const logoSrc = typeof logoImg === 'string' ? logoImg : logoImg?.src;
const coverSrc = typeof coverImg === 'string' ? coverImg : coverImg?.src;

const socialIcons: Record<string, string> = {
  website: 'fa-solid fa-globe',
  globe: 'fa-solid fa-globe',
  instagram: 'fa-brands fa-instagram',
  facebook: 'fa-brands fa-facebook-f',
  whatsapp: 'fa-brands fa-whatsapp',
  threads: 'fa-brands fa-threads',
  youtube: 'fa-brands fa-youtube',
  linkedin: 'fa-brands fa-linkedin-in',
  tiktok: 'fa-brands fa-tiktok',
  twitter: 'fa-brands fa-x-twitter',
  pinterest: 'fa-brands fa-pinterest-p',
  telegram: 'fa-brands fa-telegram',
  spotify: 'fa-brands fa-spotify',
  discord: 'fa-brands fa-discord',
  google: 'fa-brands fa-google',
  email: 'fa-solid fa-envelope',
  link: 'fa-solid fa-link',
  github: 'fa-brands fa-github',
  behance: 'fa-brands fa-behance',
  dribbble: 'fa-brands fa-dribbble'
};

const defaultLabels: Record<string, string> = {
  website: 'Site',
  globe: 'Site',
  whatsapp: 'WhatsApp',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  github: 'GitHub',
  behance: 'Behance',
  dribbble: 'Dribbble',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  email: 'E-mail'
};
---

<header class="w-full relative overflow-hidden pb-6 font-body">
  <!-- Banner de Capa com Logo Animado no Fundo (Sem linha de corte) -->
  <div class="h-52 sm:h-60 w-full relative overflow-hidden flex items-center justify-center cover-fade-mask">
    <!-- Brilho ambiente -->
    <div class="absolute w-80 h-56 bg-purple-dark/55 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute w-48 h-48 bg-accent/15 rounded-full blur-2xl pointer-events-none"></div>

    {coverSrc ? (
      <img
        src={coverSrc}
        alt="Capa"
        class="w-full h-full object-cover object-center brightness-90 animate-zoom-slow"
      />
    ) : logoSrc ? (
      <div class="relative w-full h-full flex items-center justify-center overflow-hidden -translate-y-5 translate-x-6 sm:translate-x-8">
        <img
          src={logoSrc}
          alt="Símbolo da marca"
          class="w-40 sm:w-48 h-auto object-contain opacity-30 brightness-110 drop-shadow-[0_0_28px_rgba(154,70,242,0.45)] animate-zoom-slow select-none pointer-events-none"
        />
      </div>
    ) : (
      <div class="w-full h-full bg-linear-to-r from-purple-dark/40 via-primary/20 to-purple-dark/40"></div>
    )}
  </div>

  <!-- Card Principal Flutuante -->
  <div class="max-w-md mx-auto px-1 -mt-12 relative z-10">
    <div class="bg-[#0b0412]/85 backdrop-blur-xl border border-primary/30 rounded-3xl p-5 sm:p-6 shadow-2xl shadow-purple-dark/30 flex flex-col gap-4">
      
      <!-- Topo: Retrato Vertical Sobreposto à Capa + Dados -->
      <div class="flex items-end gap-4 sm:gap-5">
        <!-- Foto Retrato Vertical (3:4) com Borda Gradiente e Sobreposição -->
        <div class="relative shrink-0 -mt-16 sm:-mt-20">
          <div class="w-25 sm:w-28 aspect-3/4 rounded-2xl p-[1.5px] bg-linear-to-b from-accent/80 via-primary/40 to-primary/10 shadow-[0_12px_32px_rgba(58,1,112,0.6)]">
            <div class="w-full h-full rounded-[14px] overflow-hidden bg-bg-dark relative">
              <img
                src={avatarSrc}
                alt={name}
                class="w-full h-full object-cover object-[center_12%]"
              />
              <!-- Vinheta sutil na base da foto para fundir com o card -->
              <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-[#0b0412]/75 via-[#0b0412]/20 to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>

        <!-- Informações da Marca -->
        <div class="flex flex-col min-w-0 flex-1 pb-0.5">
          {displayBadge && (
            <span class="font-body inline-flex items-center gap-1.5 text-[10px] font-medium tracking-[0.16em] uppercase bg-primary/15 text-purple-light px-2.5 py-0.5 rounded-full w-fit mb-2 border border-primary/30">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              {displayBadge}
            </span>
          )}

          <!-- Nome em Cormorant Garamond (Luxo Editorial) -->
          <h1 class="font-heading text-[22px] sm:text-[26px] font-semibold tracking-wide text-white leading-[1.12]">
            {name}
          </h1>

          <!-- Categoria com traço accent -->
          {displaySubtitle && (
            <div class="flex items-center gap-2 mt-2">
              <span class="w-4 h-[1.5px] bg-accent rounded-full shrink-0"></span>
              <p class="font-body text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.2em] text-purple-light/85 leading-snug">
                {displaySubtitle}
              </p>
            </div>
          )}

          {location && (
            <a
              href={locationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body inline-flex items-center gap-1.5 text-[11px] text-purple-light/70 hover:text-accent transition-colors duration-200 mt-1.5 group w-fit"
              title="Ver localização"
            >
              <i class="fa-solid fa-location-dot text-accent group-hover:scale-110 transition-transform"></i>
              <span class="underline underline-offset-2">{location}</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[8px] opacity-70 group-hover:opacity-100 transition-opacity"></i>
            </a>
          )}
        </div>
      </div>

      <!-- Redes Sociais em Chips/Pills -->
      {socialLinks.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 pt-1">
          {socialLinks.map((link) => {
            const icon = socialIcons[link.platform] || 'fa-solid fa-link';
            const labelText = link.label ?? defaultLabels[link.platform] ?? link.platform;

            return (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-body inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-medium tracking-wide bg-white/3 hover:bg-primary/20 border border-primary/25 hover:border-accent/60 text-gray-light hover:text-white transition-all duration-200 shadow-xs hover:-translate-y-0.5 active:translate-y-0"
              >
                <i class={`${icon} text-accent text-xs`}></i>
                <span class="leading-none">{labelText}</span>
              </a>
            );
          })}
        </div>
      )}

      <!-- Divisória Gradiente Minimalista (Opção 3) -->
      <div class="my-0.5">
        <div class="h-px w-full bg-linear-to-r from-transparent via-accent/45 to-transparent"></div>
      </div>

      <!-- Manifesto / Bio em Cormorant Garamond Itálico -->
      {displayBio && (
        <div class="relative pl-4 pr-3 py-3 border border-primary/15 border-l-2 border-l-accent bg-white/2 rounded-xl flex items-start gap-2.5">
          <i class="fa-solid fa-quote-left text-accent/60 text-xs mt-1 shrink-0"></i>
          <p class="font-heading italic text-base sm:text-[17px] text-purple-light/90 leading-snug font-normal">
            "{displayBio}"
          </p>
        </div>
      )}

      <!-- Botão CTA Principal (Opcional) -->
      {ctaButton && (
        <a
          href={ctaButton.url}
          target="_blank"
          rel="noopener noreferrer"
          class="font-body w-full bg-linear-to-r from-primary to-accent hover:brightness-110 text-white font-semibold tracking-[0.18em] uppercase text-[11px] py-3.5 px-4 rounded-2xl shadow-[0_8px_24px_rgba(131,67,195,0.35)] hover:shadow-[0_10px_28px_rgba(154,70,242,0.5)] flex items-center justify-center gap-2 transition-all hover:scale-[1.01] active:scale-[0.99] group mt-0.5"
        >
          {ctaButton.iconClass && <i class={`${ctaButton.iconClass} text-sm`}></i>}
          <span>{ctaButton.label}</span>
          <i class="fa-solid fa-arrow-right text-[11px] opacity-80 group-hover:translate-x-0.5 transition-transform"></i>
        </a>
      )}

    </div>
  </div>
</header>

<style>
  .cover-fade-mask {
    -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
  }

  @keyframes slowZoom {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
    }
  }

  .animate-zoom-slow {
    animation: slowZoom 14s ease-in-out infinite;
    transform-origin: center center;
  }
</style>