---
export interface BioLink {
  label: string;
  url: string;
  subtitle?: string;
  iconClass?: string;
  badgeText?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'accent';
  isExternal?: boolean;
  highlight?: boolean;
}

export interface Props {
  sectionTitle?: string;
  links: BioLink[];
}

const { sectionTitle, links = [] } = Astro.props;

// Mapeamento de estilos por variante no tema Dark/Neon
const variantClasses: Record<string, string> = {
  primary: 
    'bg-primary hover:bg-primary-hover text-white border-accent/40 hover:border-accent shadow-md shadow-accent/10',
  secondary: 
    'bg-[#120a1c] hover:bg-purple-dark/40 text-gray-light hover:text-white border-purple-dark/50 hover:border-accent/60 shadow-sm',
  accent: 
    'bg-accent hover:bg-accent/90 text-white border-accent/80 shadow-md shadow-accent/20',
  outline: 
    'bg-transparent hover:bg-purple-dark/30 text-purple-light hover:text-white border-purple-dark/60 hover:border-accent',
};
---

<div class="px-6 space-y-3 mb-6">
  {sectionTitle && (
    <p class="text-[11px] font-heading font-semibold uppercase tracking-[0.2em] text-accent/90 mb-1">
      {sectionTitle}
    </p>
  )}

  <div class="space-y-3">
    {links.map((link) => {
      const variant = link.variant || 'secondary';
      const currentVariantClass = variantClasses[variant] || variantClasses.secondary;
      const isExternal = link.isExternal ?? true;
      const iconClass = link.iconClass || 'fa-solid fa-link';

      return (
        <a
          href={link.url}
          target={isExternal ? '_blank' : '_self'}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class={`relative group w-full flex items-center justify-between p-3.5 rounded-2xl border transition-all duration-300 ease-out hover:-translate-y-0.5 active:translate-y-0 ${currentVariantClass} ${
            link.highlight
              ? 'ring-2 ring-accent/60 ring-offset-2 ring-offset-[#09050d] animate-pulse'
              : ''
          }`}
        >
          {/* Badge Superior Flutuante */}
          {link.badgeText && (
            <span class="absolute -top-2.5 right-4 bg-accent text-white text-[9px] font-heading font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-md border border-purple-dark">
              {link.badgeText}
            </span>
          )}

          {/* Container do Ícone (Esquerda) */}
          <div class="w-9 h-9 rounded-xl bg-purple-dark/40 border border-purple-dark/60 group-hover:bg-accent group-hover:border-accent group-hover:text-white transition-all duration-300 flex items-center justify-center shrink-0 mr-3 text-accent">
            <i class={`${iconClass} text-sm`} />
          </div>

          {/* Conteúdo (Label e Subtítulo) */}
          <div class="flex-1 text-left min-w-0 pr-2">
            <span class="block text-xs font-heading font-semibold tracking-wide text-white group-hover:text-accent transition-colors truncate">
              {link.label}
            </span>
            {link.subtitle && (
              <span class="block text-[11px] text-gray-light/70 font-light truncate mt-0.5">
                {link.subtitle}
              </span>
            )}
          </div>

          {/* Ícone Indicador (Seta Direita) */}
          <div class="text-xs text-purple-light/50 group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-1">
            <i class="fa-solid fa-chevron-right text-[10px]" />
          </div>
        </a>
      );
    })}
  </div>
</div>