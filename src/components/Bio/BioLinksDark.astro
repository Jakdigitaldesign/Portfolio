---
export interface BioLink {
  label: string;
  url: string;
  subtitle?: string;
  iconClass?: string;
  badgeText?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'accent';
  isExternal?: boolean;
  highlight?: boolean;
}

export interface Props {
  sectionTitle?: string;
  links: BioLink[];
}

const { sectionTitle, links = [] } = Astro.props;

// Estilos alinhados ao visual Dark Glass / Luxo Editorial
const variantClasses: Record<string, string> = {
  primary:
    'bg-linear-to-r from-primary to-accent hover:brightness-110 text-white border-accent/40 shadow-[0_8px_24px_rgba(131,67,195,0.3)] hover:shadow-[0_10px_28px_rgba(154,70,242,0.45)]',
  secondary:
    'bg-[#0b0412]/80 backdrop-blur-xl hover:bg-primary/15 text-gray-light hover:text-white border-primary/25 hover:border-accent/55 shadow-lg shadow-purple-dark/15',
  accent:
    'bg-[#140724]/90 backdrop-blur-xl hover:bg-purple-dark/45 text-white border-accent/50 hover:border-accent shadow-[0_6px_24px_rgba(154,70,242,0.18)]',
  outline:
    'bg-white/2 backdrop-blur-md hover:bg-primary/12 text-purple-light hover:text-white border-primary/25 hover:border-accent/55',
};

const iconBoxClasses: Record<string, string> = {
  primary:
    'bg-white/15 border border-white/20 text-white group-hover:bg-white/25',
  secondary:
    'bg-white/4 border border-primary/25 text-accent group-hover:bg-accent/15 group-hover:border-accent/50 group-hover:text-white',
  accent:
    'bg-accent/15 border border-accent/35 text-accent group-hover:bg-accent group-hover:text-white',
  outline:
    'bg-white/4 border border-primary/25 text-accent group-hover:bg-accent/15 group-hover:border-accent/50 group-hover:text-white',
};
---

<section class="max-w-md mx-auto px-1 space-y-3 mb-6 font-body">
  {sectionTitle && (
    <div class="flex items-center gap-2.5 px-1 pb-1">
      <span class="w-4 h-[1.5px] bg-accent rounded-full shrink-0"></span>
      <p class="font-body text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.22em] text-purple-light/80">
        {sectionTitle}
      </p>
      <div class="h-px flex-1 bg-linear-to-r from-primary/30 to-transparent"></div>
    </div>
  )}

  <div class="space-y-3">
    {links.map((link) => {
      const variant = link.variant || 'secondary';
      const currentVariantClass = variantClasses[variant] || variantClasses.secondary;
      const currentIconBoxClass = iconBoxClasses[variant] || iconBoxClasses.secondary;
      const isExternal = link.isExternal ?? true;
      const iconClass = link.iconClass || 'fa-solid fa-link';
      const isSolidPrimary = variant === 'primary';

      return (
        <a
          href={link.url}
          target={isExternal ? '_blank' : '_self'}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class={`relative group w-full flex items-center justify-between p-3.5 sm:p-4 rounded-2xl border transition-all duration-300 ease-out hover:-translate-y-0.5 active:translate-y-0 ${currentVariantClass} ${
            link.highlight
              ? 'border-accent/70 shadow-[0_0_24px_rgba(154,70,242,0.22)]'
              : ''
          }`}
        >
          {/* Badge Superior Flutuante (mesmo estilo da badge Web Design) */}
          {link.badgeText && (
            <span class="font-body absolute -top-2.5 right-4 inline-flex items-center gap-1.5 bg-[#120620] text-purple-light text-[9px] font-medium uppercase tracking-[0.16em] px-2.5 py-0.5 rounded-full shadow-md border border-accent/50">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              {link.badgeText}
            </span>
          )}

          {/* Container do Ícone (Esquerda) */}
          <div
            class={`w-10 h-10 sm:w-11 sm:h-11 rounded-xl flex items-center justify-center shrink-0 mr-3.5 transition-all duration-300 ${currentIconBoxClass}`}
          >
            <i class={`${iconClass} text-base sm:text-lg leading-none`}></i>
          </div>

          {/* Conteúdo (Label e Subtítulo) */}
          <div class="flex-1 text-left min-w-0 pr-2">
            <span
              class={`font-body block text-[13px] sm:text-sm font-semibold tracking-wide transition-colors truncate ${
                isSolidPrimary
                  ? 'text-white'
                  : 'text-white group-hover:text-purple-light'
              }`}
            >
              {link.label}
            </span>
            {link.subtitle && (
              <span
                class={`font-body block text-[11px] font-normal truncate mt-0.5 ${
                  isSolidPrimary ? 'text-white/80' : 'text-purple-light/65'
                }`}
              >
                {link.subtitle}
              </span>
            )}
          </div>

          {/* Ícone Indicador (Seta Direita) */}
          <div
            class={`text-xs group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-1 ${
              isSolidPrimary
                ? 'text-white/80 group-hover:text-white'
                : 'text-purple-light/45 group-hover:text-accent'
            }`}
          >
            <i class="fa-solid fa-arrow-right text-[11px]" />
          </div>
        </a>
      );
    })}
  </div>
</section>