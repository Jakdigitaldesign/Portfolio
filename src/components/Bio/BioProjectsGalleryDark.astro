---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  images?: ImageMetadata[];
  cardSize?: 'sm' | 'md' | 'lg';
  speedSeconds?: number;
}

const {
  title = "Projetos em Destaque",
  subtitle = "// Portfólio & Cases",
  description,
  images = [],
  cardSize = 'sm',
  speedSeconds = 35
} = Astro.props;

// Se nenhuma prop de imagem for passada, busca automaticamente as fotos da pasta de projetos
let displayImages: ImageMetadata[] = images;

if (displayImages.length === 0) {
  const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/*.{jpeg,jpg,png,webp}', { eager: true });
  displayImages = Object.values(imageFiles).map((mod) => mod.default);
}

// Divide as fotos ao meio para criar as 2 linhas independentes
const metade = Math.ceil(displayImages.length / 2);
const linha1 = displayImages.slice(0, metade);
const linha2 = displayImages.slice(metade);

// Mapeamento de tamanhos dos cards
const sizeClasses = {
  sm: 'w-32 h-32 sm:w-40 sm:h-40',
  md: 'w-36 h-36 sm:w-48 sm:h-48',
  lg: 'w-44 h-44 sm:w-56 sm:h-56'
}[cardSize];
---

<section class="w-full max-w-md mx-auto px-6 py-3 text-gray-light overflow-hidden">
  
  <!-- Container Principal estilo Card Dark Glassmorphism -->
  <div class="bg-[#120a1c]/60 backdrop-blur-md border border-purple-dark/40 rounded-2xl py-5 shadow-lg relative overflow-hidden">
    
    <!-- Glow de fundo discreto -->
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-48 bg-accent/15 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Cabeçalho da Galeria -->
    <div class="text-center px-4 mb-4 relative z-10">
      {subtitle && (
        <span class="text-[10px] font-heading font-semibold uppercase tracking-[0.2em] text-accent block mb-1">
          {subtitle}
        </span>
      )}
      <h2 class="text-lg font-heading font-bold text-white tracking-wide">
        {title}
      </h2>
      <div class="w-10 h-0.5 bg-accent mx-auto mt-1.5 rounded-full shadow-xs shadow-accent/50"></div>
      
      {description && (
        <p class="text-xs text-gray-light/70 mt-2 font-light leading-relaxed max-w-xs mx-auto">
          {description}
        </p>
      )}
    </div>

    <!-- Wrapper do Carrossel de 2 Linhas -->
    <div class="marquee-wrapper flex flex-col gap-3 w-full overflow-hidden group relative z-10">
      
      <!-- Linha 1: Desliza para a Esquerda -->
      {linha1.length > 0 && (
        <div 
          class="marquee-track track-1 flex gap-3 w-max"
          style={`--speed: ${speedSeconds}s;`}
        >
          {linha1.concat(linha1).map((imgObj, index) => (
           <div 
  class={`photo-card ${sizeClasses} shrink-0 rounded-xl overflow-hidden shadow-md border border-purple-dark/60 bg-[#09050d] cursor-pointer transition-all duration-300 hover:scale-105 hover:border-accent hover:shadow-accent/20 relative flex`} 
  data-fullsrc={imgObj.src}
>
  <Image 
  src={imgObj} 
  alt={`${title} - Projeto ${index + 1}`} 
  width={300}  
  height={300} 
  fit="cover"
  position="top"
  format="webp"
  loading="lazy"
  class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity"
/>
</div>
          ))}
        </div>
      )}

      <!-- Linha 2: Desliza para a Direita -->
      {linha2.length > 0 && (
        <div 
          class="marquee-track track-2 flex gap-3 w-max"
          style={`--speed: ${speedSeconds}s;`}
        >
          {linha2.concat(linha2).map((imgObj, index) => (
            <div 
              class={`photo-card ${sizeClasses} shrink-0 rounded-xl overflow-hidden shadow-md border border-purple-dark/60 bg-[#09050d] cursor-pointer transition-all duration-300 hover:scale-105 hover:border-accent hover:shadow-accent/20`} 
              data-fullsrc={imgObj.src}
            >
              <Image 
  src={imgObj} 
  alt={`${title} - Projeto ${index + 1}`} 
  width={300}  
  height={300} 
  fit="cover"
  position="top"
  format="webp"
  loading="lazy"
  class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity"
/>
            </div>
          ))}
        </div>
      )}

    </div>
  </div>

  <!-- Modal Lightbox Ampliado -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4 transition-opacity">
    <button type="button" class="lightbox-close absolute top-4 right-5 text-gray-light hover:text-accent text-3xl font-light cursor-pointer z-50 leading-none transition-colors">&times;</button>
    <img class="lightbox-content max-w-[90vw] max-h-[85vh] rounded-xl object-contain shadow-2xl border border-purple-dark/60" id="lightbox-img" alt="Projeto ampliado" />
  </div>

</section>

<!-- Script do Modal Lightbox -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.querySelector('.lightbox-close');
    const photoCards = document.querySelectorAll('.photo-card');

    if (!modal || !modalImg) return;

    photoCards.forEach((card) => {
      card.addEventListener('click', () => {
        const fullSrc = card.getAttribute('data-fullsrc');
        if (fullSrc) {
          modalImg.src = fullSrc;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>

<style>
  /* Animações contínuas via CSS Puro */
  .track-1 {
    animation: scrollLeft var(--speed, 35s) linear infinite;
  }

  .track-2 {
    animation: scrollRight var(--speed, 35s) linear infinite;
  }

  /* Pausa a animação ao passar o mouse */
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
</style>