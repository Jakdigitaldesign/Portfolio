---
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  desktopImages?: ImageMetadata[];
  mobileImages?: ImageMetadata[];
  cardSize?: 'sm' | 'md' | 'lg';
  speedSeconds?: number;
}

const {
  title = "Projetos em Destaque",
  subtitle = "Portfólio & Cases",
  description,
  desktopImages = [],
  mobileImages = [],
  cardSize = 'sm',
  speedSeconds = 30
} = Astro.props;

// Carregamento automático caso não passem props (separa por pastas)
let linha1: ImageMetadata[] = desktopImages;
let linha2: ImageMetadata[] = mobileImages;

if (linha1.length === 0) {
  const desktopFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/desktop/*.{jpeg,jpg,png,webp}', { eager: true });
  linha1 = Object.values(desktopFiles).map((mod) => mod.default);

  if (linha1.length === 0) {
    const allFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/*.{jpeg,jpg,png,webp}', { eager: true });
    const allImages = Object.values(allFiles).map((mod) => mod.default);
    const metade = Math.ceil(allImages.length / 2);
    linha1 = allImages.slice(0, metade);
    linha2 = allImages.slice(metade);
  }
}

if (linha2.length === 0 && mobileImages.length === 0) {
  const mobileFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/mobile/*.{jpeg,jpg,png,webp}', { eager: true });
  linha2 = Object.values(mobileFiles).map((mod) => mod.default);
}

// 1. Desktop / Landing Pages
const desktopSizeClasses = {
  sm: 'w-60 h-[195px] sm:w-64 sm:h-[215px]',
  md: 'w-64 h-[220px] sm:w-72 sm:h-[245px]',
  lg: 'w-72 h-[245px] sm:w-80 sm:h-[270px]'
}[cardSize];

// 2. Minisites (Mobile)
const mobileSizeClasses = {
  sm: 'w-36 h-64 sm:w-40 sm:h-72',
  md: 'w-40 h-72 sm:w-44 sm:h-80',
  lg: 'w-44 h-80 sm:w-48 sm:h-88'
}[cardSize];

const hasMobile = linha2.length > 0;
const hasDesktop = linha1.length > 0;
const defaultTab = hasMobile ? 'mobile' : 'desktop';
---

<section class="w-full max-w-md mx-auto px-1 my-5 text-gray-light font-body">
  <!-- Container Principal Dark Glassmorphism -->
  <div class="bg-[#0b0412]/85 backdrop-blur-xl border border-primary/30 rounded-3xl py-6 shadow-2xl shadow-purple-dark/25 relative overflow-hidden">
    
    <!-- Brilho ambiente discreto -->
    <div class="absolute -top-14 left-1/2 -translate-x-1/2 w-56 h-48 bg-purple-dark/45 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-32 h-32 bg-accent/10 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Cabeçalho da Galeria -->
    <div class="text-center px-5 mb-5 relative z-10">
      {subtitle && (
        <div class="inline-flex items-center justify-center gap-2 mb-1.5">
          <span class="w-3.5 h-[1.5px] bg-accent rounded-full"></span>
          <span class="font-body text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.22em] text-purple-light/85">
            {subtitle}
          </span>
          <span class="w-3.5 h-[1.5px] bg-accent rounded-full"></span>
        </div>
      )}

      <h2 class="font-heading text-2xl sm:text-[26px] font-semibold text-white tracking-wide leading-tight">
        {title}
      </h2>

      <!-- Divisória Gradiente Minimalista -->
      <div class="h-px w-32 bg-linear-to-r from-transparent via-accent/55 to-transparent mx-auto mt-2.5"></div>

      {description && (
        <p class="font-body text-xs text-purple-light/70 mt-3 font-normal leading-relaxed max-w-xs mx-auto">
          {description}
        </p>
      )}

      <!-- Botões de Abas (Tabs) -->
      {hasMobile && hasDesktop && (
        <div class="grid grid-cols-2 items-center gap-1 mt-4 p-1 bg-white/3 backdrop-blur-md rounded-full border border-primary/25 max-w-65 mx-auto">
          <button
            type="button"
            data-tab="mobile"
            data-active="true"
            class="tab-btn py-1.5 px-3 rounded-full text-xs font-medium tracking-wide transition-all duration-300 cursor-pointer text-purple-light/65 hover:text-white data-[active=true]:bg-linear-to-r data-[active=true]:from-primary data-[active=true]:to-accent data-[active=true]:text-white data-[active=true]:shadow-[0_4px_16px_rgba(131,67,195,0.4)]"
          >
            Minisites
          </button>
          <button
            type="button"
            data-tab="desktop"
            data-active="false"
            class="tab-btn py-1.5 px-3 rounded-full text-xs font-medium tracking-wide transition-all duration-300 cursor-pointer text-purple-light/65 hover:text-white data-[active=true]:bg-linear-to-r data-[active=true]:from-primary data-[active=true]:to-accent data-[active=true]:text-white data-[active=true]:shadow-[0_4px_16px_rgba(131,67,195,0.4)]"
          >
            Sites & Lojas
          </button>
        </div>
      )}
    </div>

    <!-- Wrapper dos Carrosséis com Fade Suave nas Laterais -->
    <div class="marquee-wrapper marquee-fade-x flex flex-col w-full overflow-hidden group relative z-10 min-h-72 justify-center py-2">
      
      <!-- ABA 1: Minisites (Mobile) -->
      {hasMobile && (
        <div id="tab-content-mobile" class={`tab-content ${defaultTab === 'mobile' ? 'block' : 'hidden'}`}>
          <div
            class="marquee-track track-2 flex gap-4 w-max items-center"
            style={`--speed: ${speedSeconds}s;`}
          >
            {linha2.concat(linha2).map((imgObj, index) => (
              <div
                class={`photo-card group/card ${mobileSizeClasses} shrink-0 overflow-hidden rounded-[22px] shadow-[0_10px_28px_rgba(0,0,0,0.65)] border border-primary/35 bg-[#06020b] cursor-pointer transition-all duration-300 hover:scale-[1.03] hover:border-accent/80 hover:shadow-[0_12px_30px_rgba(154,70,242,0.22)] relative flex flex-col p-1.5`}
                data-fullsrc={imgObj.src}
                data-type="mobile"
              >
                <!-- Detalhe estilo Câmera / Ilha Dinâmica -->
                <div class="absolute top-2.5 left-1/2 -translate-x-1/2 w-9 h-1 bg-[#1b0c2e] border border-primary/25 rounded-full z-20 pointer-events-none"></div>

                <div class="w-full h-full overflow-hidden rounded-2xl relative bg-bg-dark flex items-start justify-center">
                 <img
                  src={imgObj.src}
                  alt={`${title} Minisite ${index + 1}`}
                  loading={"eager"}
                  decoding="async"
                  class="w-full h-auto block object-cover object-top opacity-90 group-hover/card:opacity-100 transition-opacity duration-300"
                />
                  <!-- Indicador sutil de ampliar no hover -->
                  <div class="absolute bottom-2 right-2 w-6 h-6 rounded-full bg-[#0b0412]/80 border border-accent/40 text-purple-light flex items-center justify-center opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 pointer-events-none">
                    <i class="fa-solid fa-expand text-[9px]"></i>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- ABA 2: Sites & Lojas (Desktop) -->
{hasDesktop && (
  <div id="tab-content-desktop" class={`tab-content ${defaultTab === 'desktop' ? 'block' : 'hidden'}`}>
    <div
      class="marquee-track track-2 flex gap-4 w-max items-center py-1"
      style={`--speed: ${speedSeconds}s;`}
    >
      {linha1.concat(linha1).map((imgObj, index) => (
        <div
          class={`photo-card group/card ${desktopSizeClasses} shrink-0 overflow-hidden rounded-2xl shadow-[0_12px_30px_rgba(0,0,0,0.65)] border border-primary/35 bg-[#090312] cursor-pointer transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/80 hover:shadow-[0_14px_34px_rgba(154,70,242,0.25)] relative flex flex-col p-1.5`}
          data-fullsrc={imgObj.src}
          data-type="desktop"
        >
       <!-- Barra superior estilo navegador desktop -->
<div class="w-full h-4.5 px-2.5 flex items-center justify-between gap-2 bg-[#140724] rounded-t-xl border-b border-primary/25 shrink-0">
  <div class="flex items-center gap-1 shrink-0">
    <span class="w-1.5 h-1.5 rounded-full bg-accent/80"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-primary/60"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-primary/35"></span>
  </div>
  <div class="flex-1 max-w-[65%] h-2.5 rounded-full bg-white/5 border border-primary/20 px-2 flex items-center justify-center gap-1">
    <i class="fa-solid fa-lock text-[6px] text-accent/70"></i>
    <span class="text-[7px] text-purple-light/60 truncate leading-none">
      projeto-{String(index + 1).padStart(2, '0')}.com.br
    </span>
  </div>
  <span class="w-3 shrink-0"></span>
</div>

        <!-- Área da captura do site -->
<div class="w-full flex-1 overflow-hidden rounded-b-xl relative bg-bg-dark">
  <img
  src={imgObj.src}
  alt={`${title || 'Projeto'} Desktop ${index + 1}`}
  loading={"eager"}
  decoding="async"
  class="w-full h-full object-cover object-top opacity-95 group-hover/card:opacity-100 group-hover/card:scale-[1.02] transition-all duration-300"
/>

            <!-- Gradiente inferior sutil + badge de ampliar -->
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-10 bg-linear-to-t from-[#06020b]/90 via-[#06020b]/35 to-transparent"></div>

            <div class="absolute bottom-2 right-2 w-6 h-6 rounded-full bg-[#0b0412]/85 border border-accent/45 text-purple-light flex items-center justify-center opacity-80 group-hover/card:opacity-100 group-hover/card:border-accent transition-all duration-300 pointer-events-none">
              <i class="fa-solid fa-expand text-[9px]"></i>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

    </div>
  </div>

  <!-- Modal Lightbox Otimizado com Rolagem Vertical -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-3 sm:p-4">
    
    <!-- Botão Fechar -->
    <button
      type="button"
      class="lightbox-close absolute top-3 right-4 sm:top-5 sm:right-6 text-purple-light/85 hover:text-white bg-[#120620]/85 hover:bg-primary/40 border border-primary/40 hover:border-accent p-2.5 rounded-full backdrop-blur-md z-50 cursor-pointer transition-all flex items-center justify-center leading-none shadow-lg"
      aria-label="Fechar modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Instrução sutil de Scroll -->
    <div class="font-body absolute bottom-3 left-1/2 -translate-x-1/2 text-[10px] font-medium uppercase tracking-[0.18em] text-purple-light/80 bg-[#120620]/85 px-3.5 py-1.5 rounded-full border border-primary/35 backdrop-blur-md pointer-events-none z-50 whitespace-nowrap shadow-lg">
      ↕ Role para ver o projeto completo
    </div>

    <!-- Moldura de Dispositivo / Visualizador com Scroll Interno -->
    <div
      id="lightbox-container"
      class="w-full max-w-sm h-[82vh] max-h-205 bg-[#090410] rounded-3xl border border-primary/40 shadow-[0_20px_60px_rgba(58,1,112,0.5)] overflow-y-auto scroller-thin relative flex flex-col transition-all"
    >
      <img
        class="w-full h-auto block select-none"
        id="lightbox-img"
        alt="Projeto completo"
      />
    </div>
  </div>
</section>

<!-- Script para Alternância de Abas e Modal Lightbox -->
<script>
  const initPortfolioMarquee = () => {
    // 1. Lógica das Abas (Tabs)
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        tabBtns.forEach((b) => b.setAttribute('data-active', 'false'));
        btn.setAttribute('data-active', 'true');

        tabContents.forEach((content) => {
          if (content.id === `tab-content-${targetTab}`) {
            content.classList.remove('hidden');
            content.classList.add('block');
          } else {
            content.classList.remove('block');
            content.classList.add('hidden');
          }
        });
      });
    });

    // 2. Lógica do Modal com Scroll e Adaptação Desktop/Mobile
    const modal = document.getElementById('lightbox-modal');
    const modalContainer = document.getElementById('lightbox-container');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.querySelector('.lightbox-close');
    const photoCards = document.querySelectorAll('.photo-card');

    if (!modal || !modalImg || !modalContainer) return;

    photoCards.forEach((card) => {
      card.addEventListener('click', () => {
        const fullSrc = card.getAttribute('data-fullsrc');
        const type = card.getAttribute('data-type');

        if (fullSrc) {
          modalImg.src = fullSrc;

          if (type === 'desktop') {
            modalContainer.classList.remove('max-w-sm', 'rounded-3xl');
            modalContainer.classList.add('max-w-2xl', 'rounded-2xl');
          } else {
            modalContainer.classList.remove('max-w-2xl', 'rounded-2xl');
            modalContainer.classList.add('max-w-sm', 'rounded-3xl');
          }

          modalContainer.scrollTop = 0;

          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPortfolioMarquee);
  } else {
    initPortfolioMarquee();
  }
</script>

<style>
  /* Fade suave nas laterais do carrossel */
  .marquee-fade-x {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  /* Animações contínuas via CSS Puro */
  .track-1 {
    animation: scrollLeft var(--speed, 30s) linear infinite;
  }

  .track-2 {
    animation: scrollRight var(--speed, 30s) linear infinite;
  }

  /* Pausa a animação ao passar o mouse ou segurar o toque */
  .marquee-wrapper:hover .marquee-track,
  .marquee-wrapper:active .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
</style>