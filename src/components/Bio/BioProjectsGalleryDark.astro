---
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  desktopImages?: ImageMetadata[];
  mobileImages?: ImageMetadata[];
  cardSize?: 'sm' | 'md' | 'lg';
  speedSeconds?: number;
}

const {
  title = "Projetos em Destaque",
  subtitle = "// Portfólio & Cases",
  description,
  desktopImages = [],
  mobileImages = [],
  cardSize = 'sm',
  speedSeconds = 30
} = Astro.props;

// Carregamento automático caso não passem props (separa por pastas)
let linha1: ImageMetadata[] = desktopImages;
let linha2: ImageMetadata[] = mobileImages;

if (linha1.length === 0) {
  const desktopFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/desktop/*.{jpeg,jpg,png,webp}', { eager: true });
  linha1 = Object.values(desktopFiles).map((mod) => mod.default);
  
  if (linha1.length === 0) {
    const allFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/*.{jpeg,jpg,png,webp}', { eager: true });
    const allImages = Object.values(allFiles).map((mod) => mod.default);
    const metade = Math.ceil(allImages.length / 2);
    linha1 = allImages.slice(0, metade);
    linha2 = allImages.slice(metade);
  }
}

if (linha2.length === 0 && mobileImages.length === 0) {
  const mobileFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/projetos/mobile/*.{jpeg,jpg,png,webp}', { eager: true });
  linha2 = Object.values(mobileFiles).map((mod) => mod.default);
}

// 1. Desktop / Landing Pages
const desktopSizeClasses = {
  sm: 'w-52 h-36 sm:w-60 sm:h-44',
  md: 'w-60 h-44 sm:w-72 sm:h-52',
  lg: 'w-72 sm:w-80 h-56'
}[cardSize];

// 2. Minisites (Mobile) - TAMANHOS AMPLIADOS para melhor visualização no celular
const mobileSizeClasses = {
  sm: 'w-36 h-64 sm:w-40 sm:h-72',
  md: 'w-40 h-72 sm:w-44 sm:h-80',
  lg: 'w-44 h-80 sm:w-48 sm:h-88'
}[cardSize];
---

<section class="w-full max-w-md mx-auto px-4 py-3 text-gray-light overflow-hidden">
  
  <!-- Container Principal estilo Card Dark Glassmorphism -->
  <div class="bg-[#120a1c]/60 backdrop-blur-md border border-purple-dark/40 rounded-2xl py-5 shadow-lg relative overflow-hidden">
    
    <!-- Glow de fundo discreto -->
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-48 bg-accent/15 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Cabeçalho da Galeria -->
    <div class="text-center px-4 mb-4 relative z-10">
      {subtitle && (
        <span class="text-[10px] font-heading font-semibold uppercase tracking-[0.2em] text-accent block mb-1">
          {subtitle}
        </span>
      )}
      <h2 class="text-lg font-heading font-bold text-white tracking-wide">
        {title}
      </h2>
      <div class="w-10 h-0.5 bg-accent mx-auto mt-1.5 rounded-full shadow-xs shadow-accent/50"></div>
      
      {description && (
        <p class="text-xs text-gray-light/70 mt-2 font-light leading-relaxed max-w-xs mx-auto">
          {description}
        </p>
      )}

      <!-- BOTOES DE ABAS (TABS) -->
      <div class="flex items-center justify-center gap-2 mt-4 p-1 bg-[#09050d]/80 rounded-full border border-purple-dark/50 max-w-70 mx-auto">
        <button 
          type="button"
          data-tab="mobile"
          class="tab-btn active-tab flex-1 py-1.5 px-3 rounded-full text-xs font-semibold transition-all duration-300 cursor-pointer text-white bg-accent/80 shadow-md shadow-accent/20"
        >
          Minisites
        </button>
        <button 
          type="button"
          data-tab="desktop"
          class="tab-btn flex-1 py-1.5 px-3 rounded-full text-xs font-semibold transition-all duration-300 cursor-pointer text-gray-light/60 hover:text-white hover:bg-white/5"
        >
          Sites & Lojas
        </button>
      </div>
    </div>

    <!-- Wrapper dos Carrosséis -->
    <div class="marquee-wrapper flex flex-col w-full overflow-hidden group relative z-10 min-h-72 justify-center py-2">
      
      <!-- ABA 1: Minisites (Mobile) -->
      {linha2.length > 0 && (
        <div id="tab-content-mobile" class="tab-content block">
          <div 
            class="marquee-track track-2 flex gap-4 w-max items-center"
            style={`--speed: ${speedSeconds}s;`}
          >
            {linha2.concat(linha2).map((imgObj, index) => (
              <div 
                class={`photo-card ${mobileSizeClasses} shrink-0 overflow-hidden rounded-2xl shadow-xl border-2 border-purple-dark/80 bg-[#060309] cursor-pointer transition-all duration-300 hover:scale-105 hover:border-accent hover:shadow-accent/20 relative flex flex-col p-1.5`} 
                data-fullsrc={imgObj.src}
                data-type="mobile"
              >
                <!-- Detalhe estilo Câmera/Ilha -->
                <div class="absolute top-2 left-1/2 -translate-x-1/2 w-10 h-1.5 bg-purple-dark/80 rounded-full z-20 pointer-events-none"></div>

                <div class="w-full h-full overflow-hidden rounded-xl relative bg-black flex items-start justify-center">
                  <img 
                    src={imgObj.src} 
                    alt={`${title} Minisite ${index + 1}`} 
                    loading="lazy"
                    class="w-full h-auto block object-cover object-top opacity-95 hover:opacity-100 transition-opacity"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- ABA 2: Sites & Lojas (Desktop) -->
      {linha1.length > 0 && (
        <div id="tab-content-desktop" class="tab-content hidden">
          <div 
            class="marquee-track track-2 flex gap-4 w-max items-center"
            style={`--speed: ${speedSeconds}s;`}
          >
            {linha1.concat(linha1).map((imgObj, index) => (
              <div 
                class={`photo-card ${desktopSizeClasses} shrink-0 overflow-hidden rounded-xl shadow-md border border-purple-dark/60 bg-[#09050d] cursor-pointer transition-all duration-300 hover:scale-105 hover:border-accent hover:shadow-accent/20 relative flex items-start justify-center p-1`} 
                data-fullsrc={imgObj.src}
                data-type="desktop"
              >
                <img 
                  src={imgObj.src} 
                  alt={`${title} Desktop ${index + 1}`} 
                  loading="lazy"
                  class="w-full h-full object-cover object-top rounded-lg opacity-90 hover:opacity-100 transition-opacity"
                />
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>

  <!-- Modal Lightbox Otimizado com Rolagem Vertical -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-3 sm:p-4">
    
    <!-- Botão Fechar -->
    <button 
      type="button" 
      class="lightbox-close absolute top-3 right-4 sm:top-5 sm:right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-2 rounded-full backdrop-blur-sm z-50 cursor-pointer transition-all flex items-center justify-center leading-none"
      aria-label="Fechar modal"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Instrução sutil de Scroll -->
    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 text-[11px] uppercase tracking-wider text-white/60 bg-black/60 px-3 py-1 rounded-full border border-white/10 pointer-events-none z-50">
      ↕ Role para ver o projeto completo
    </div>

    <!-- Moldura de Dispositivo / Visualizador com Scroll Interno -->
    <div 
      id="lightbox-container" 
      class="w-full max-w-sm h-[82vh] max-h-205 bg-[#0d0714] rounded-3xl border-2 border-purple-dark/80 shadow-2xl overflow-y-auto scrollbar-thin relative flex flex-col transition-all"
    >
      <img 
        class="w-full h-auto block select-none" 
        id="lightbox-img" 
        alt="Projeto completo" 
      />
    </div>
  </div>

</section>

<!-- Script para Alternância de Abas e Modal Lightbox -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Lógica das Abas (Tabs)
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        tabBtns.forEach(b => {
          b.classList.remove('text-white', 'bg-accent/80', 'shadow-md', 'shadow-accent/20');
          b.classList.add('text-gray-light/60', 'hover:text-white');
        });

        btn.classList.remove('text-gray-light/60', 'hover:text-white');
        btn.classList.add('text-white', 'bg-accent/80', 'shadow-md', 'shadow-accent/20');

        tabContents.forEach(content => {
          if (content.id === `tab-content-${targetTab}`) {
            content.classList.remove('hidden');
            content.classList.add('block');
          } else {
            content.classList.remove('block');
            content.classList.add('hidden');
          }
        });
      });
    });

    // 2. Lógica do Modal com Scroll e Adaptação Desktop/Mobile
    const modal = document.getElementById('lightbox-modal');
    const modalContainer = document.getElementById('lightbox-container');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.querySelector('.lightbox-close');
    const photoCards = document.querySelectorAll('.photo-card');

    if (!modal || !modalImg || !modalContainer) return;

    photoCards.forEach((card) => {
      card.addEventListener('click', () => {
        const fullSrc = card.getAttribute('data-fullsrc');
        const type = card.getAttribute('data-type');

        if (fullSrc) {
          modalImg.src = fullSrc;
          
          // Se for desktop, expande a largura da moldura; se for mobile, foca no formato smartphone
          if (type === 'desktop') {
            modalContainer.classList.remove('max-w-sm', 'rounded-3xl');
            modalContainer.classList.add('max-w-2xl', 'rounded-xl');
          } else {
            modalContainer.classList.remove('max-w-2xl', 'rounded-xl');
            modalContainer.classList.add('max-w-sm', 'rounded-3xl');
          }

          // Reseta a rolagem sempre para o topo ao abrir
          modalContainer.scrollTop = 0;
          
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden'; // Evita rolagem da página ao fundo
        }
      });
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      // Fecha ao clicar fora da moldura
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>

<style>
  /* Animações contínuas via CSS Puro */
  .track-1 {
    animation: scrollLeft var(--speed, 30s) linear infinite;
  }

  .track-2 {
    animation: scrollRight var(--speed, 30s) linear infinite;
  }

  /* Pausa a animação ao passar o mouse ou segurar o toque */
  .marquee-wrapper:hover .marquee-track,
  .marquee-wrapper:active .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Estilização da barra de rolagem interna do Modal */
  .scrollbar-thin::-webkit-scrollbar {
    width: 5px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.4);
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(168, 85, 247, 0.4);
    border-radius: 9999px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(168, 85, 247, 0.8);
  }
</style>