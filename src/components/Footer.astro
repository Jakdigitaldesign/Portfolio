---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
const cnpj = "65.724.340/0001-00"; 
---

<footer class="bg-bg-dark border-t border-purple-dark/50 pt-12 pb-6 relative overflow-hidden">
  <!-- Brilho decorativo no rodapé -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-96 h-24 bg-primary/10 blur-[90px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-8 border-b border-purple-dark/40">
      
      <!-- COLUNA 1: LOGO, SOBRE E REDES SOCIAIS -->
      <div class="lg:col-span-5 space-y-4">
        <a href="#inicio" class="inline-block group">
          <img src={`${import.meta.env.BASE_URL}Logo.png`} alt="Logo" class="h-8 w-auto object-contain" />
        </a>
        <p class="font-body text-gray-light text-sm max-w-sm leading-relaxed">
          Soluções digitais estratégicas, desenvolvimento web de alta performance e SaaS para acelerar pequenos negócios.
        </p>

        <!-- ÍCONES DAS REDES SOCIAIS (HORIZONTAL) -->
        <div class="flex items-center gap-2 pt-1">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/jak.digitaldesign/" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Instagram"
            class="p-2 rounded-lg bg-purple-dark/30 border border-purple-dark/60 text-accent hover:bg-accent hover:text-white transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a 
            href="https://www.linkedin.com/in/jaqueline-souza95/" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="LinkedIn"
            class="p-2 rounded-lg bg-purple-dark/30 border border-purple-dark/60 text-accent hover:bg-accent hover:text-white transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- COLUNA 2: NAVEGAÇÃO / NAVEGAR -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-heading font-bold text-xs tracking-wider uppercase text-accent mb-3">
          Navegação
        </h3>
        <ul class="space-y-2 font-body text-sm text-gray-light">
          <li><a href="#sobre" class="hover:text-white transition-colors">Sobre mim</a></li>
          <li><a href="#servicos" class="hover:text-white transition-colors">Serviços</a></li>
          <li><a href="#projetos" class="hover:text-white transition-colors">Portfólio</a></li>
          <li><a href="/termos" class="hover:text-white transition-colors">Termos de Uso</a></li>
          <li><a href="/privacidade" class="hover:text-white transition-colors">Privacidade</a></li>
        </ul>
      </div>

      <!-- COLUNA 3: CONTATO E LOCALIZAÇÃO -->
      <div class="lg:col-span-4 space-y-3">
        <h3 class="font-heading font-bold text-xs tracking-wider uppercase text-accent mb-3">
          Atendimento
        </h3>
        <ul class="space-y-2.5 font-body text-sm text-gray-light">
          <!-- E-MAIL -->
          <li>
            <a href="mailto:contato@jakdigitaldesign.com" class="inline-flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>contato@jakdigitaldesign.com</span>
            </a>
          </li>

          <!-- WHATSAPP -->
          <li>
            <a href="https://wa.me/5541984940848" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 fill-current text-accent shrink-0" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
              </svg>
              <span>(41) 98494-0848</span>
            </a>
          </li>

          <!-- LOCALIZAÇÃO -->
          <li>
            <a href="https://maps.google.com/?q=saojosedospinhais,+PR" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>São José dos Pinhais, PR</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- RODAPÉ INFERIOR: COPYRIGHT E CNPJ -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-body text-gray-light/70 text-center sm:text-left">
      <p>Jak Digital Design © {currentYear} — Todos os direitos reservados.</p>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md border border-purple-dark/60 bg-purple-dark/20 text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          PT-BR
        </span>
        <p>CNPJ: {cnpj}</p>
      </div> 
    </div>
  </div>
</footer>