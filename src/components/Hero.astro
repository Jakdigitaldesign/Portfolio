---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import mockupImg from '../assets/hero.webp';
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24 font-body">
  <!-- Padrão de Grid / Fundo Texturizado Sutil (Corrigido) -->
  <div class="absolute inset-0 bg-[radial-gradient(#8343c3_1px,transparent_1px)] bg-size-[24px_24px] opacity-20 -z-20 pointer-events-none"></div>

  <!-- Efeito de brilho de fundo (Glow Effect) -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-purple-dark/45 blur-[150px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- COLUNA DA ESQUERDA: TEXTOS E CTA -->
      <div class="lg:col-span-6 text-center lg:text-left">
        
        <!-- BADGE SUPERIOR (em Plus Jakarta Sans) -->
        <div class="font-body inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/35 bg-primary/15 backdrop-blur-md text-purple-light text-[11px] font-medium uppercase tracking-[0.2em] mb-6 shadow-sm">
          <span class="flex h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
          WEB DESIGN & TECNOLOGIA
        </div>

        <!-- TÍTULO PRINCIPAL (Cormorant Garamond Editorial) -->
        <h1 class="font-heading font-semibold text-4xl sm:text-5xl lg:text-[58px] text-white leading-[1.06] tracking-tight mb-6">
          Transforme sua presença digital em uma{" "}
          <span class="italic text-transparent bg-clip-text bg-linear-to-r from-purple-light via-accent to-primary pr-1">
            estrutura que vende
          </span>{" "}
          24 horas por dia.
        </h1>

        <!-- SUBTÍTULO / DESCRIÇÃO -->
        <p class="font-body text-purple-light/75 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed font-normal">
          Chega de perder vendas por não ter uma estrutura digital completa. Desenvolvemos <strong class="text-white font-semibold">Sites e Landing Pages de Alta Conversão</strong>, <strong class="text-white font-semibold">Mini Sites para Bio</strong> e ecossistemas completos com nosso SaaS <strong class="text-white font-semibold">Foxped</strong>.
        </p>

        <!-- BOTÕES DE AÇÃO (em Plus Jakarta Sans) -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
          <a
            href="https://wa.me/5541984940848"
            target="_blank"
            rel="noopener noreferrer"
            class="font-body w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-linear-to-r from-primary to-accent hover:brightness-110 text-white font-semibold tracking-wider uppercase text-xs sm:text-[13px] px-8 py-4 rounded-2xl shadow-[0_8px_28px_rgba(131,67,195,0.35)] hover:shadow-[0_12px_32px_rgba(154,70,242,0.5)] transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
            </svg>
            Iniciar Projeto
          </a>

          <a
            href="#servicos"
            class="font-body w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-primary/35 bg-[#0b0412]/80 hover:bg-primary/15 hover:border-accent/60 backdrop-blur-xl text-purple-light hover:text-white font-semibold tracking-wider uppercase text-xs sm:text-[13px] px-7 py-4 rounded-2xl transition-all duration-300"
          >
            Ver Ecossistema
          </a>
        </div>

        <!-- INDICADORES DE CONFIANÇA (Ícones refinados sem emojis do sistema) -->
        <div class="flex items-center justify-center lg:justify-start gap-5 pt-6 border-t border-primary/20">
          <div class="flex -space-x-2 shrink-0">
            <span class="h-8 w-8 rounded-full ring-2 ring-bg-dark bg-[#140724] border border-primary/40 flex items-center justify-center text-accent">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </span>
            <span class="h-8 w-8 rounded-full ring-2 ring-bg-dark bg-[#140724] border border-primary/40 flex items-center justify-center text-purple-light">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            </span>
            <span class="h-8 w-8 rounded-full ring-2 ring-bg-dark bg-[#140724] border border-primary/40 flex items-center justify-center text-accent">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </div>
          <p class="text-xs text-purple-light/70 font-body text-left leading-relaxed">
            Projetos focados em <span class="text-white font-semibold">velocidade, conversão</span> e <span class="text-white font-semibold">escalabilidade</span>.
          </p>
        </div>

      </div>

      <!-- COLUNA DA DIREITA: MOCKUP E PILARES LOGO ABAIXO -->
      <div class="lg:col-span-6 flex flex-col items-center lg:items-end mt-8 lg:mt-0">
        <div class="relative w-full max-w-lg lg:max-w-none">
          
          <!-- Brilho exclusivo atrás do mockup -->
          <div class="absolute inset-0 bg-linear-to-tr from-primary/30 to-accent/30 rounded-3xl blur-3xl -z-10 transform scale-105"></div>
          
          <!-- MOCKUP PRINCIPAL -->
          <Image 
            src={mockupImg} 
            alt="Projetos de alta performance da agência" 
            class="w-full h-auto object-contain drop-shadow-[0_20px_35px_rgba(58,1,112,0.5)] transform hover:scale-[1.02] transition-transform duration-500 lg:scale-115 origin-right"
            loading="eager"
          />

          <!-- FLOATING BADGE 1 (SaaS Foxped) -->
          <div class="hidden sm:flex absolute -top-4 -left-4 items-center gap-3 p-3.5 rounded-2xl bg-[#0b0412]/85 border border-primary/35 backdrop-blur-xl shadow-2xl shadow-purple-dark/40 animate-bounce-slow z-10">
            <div class="p-2 rounded-xl bg-accent/15 border border-accent/25 text-accent">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
              <p class="font-body font-semibold text-xs text-white tracking-wide">Foxped SaaS</p>
              <p class="font-body text-[10px] text-purple-light/70">Cardápio & Pedidos Online</p>
            </div>
          </div>

          <!-- FLOATING BADGE 2 (Bio e Landing Pages) -->
          <div class="hidden sm:flex absolute -bottom-4 -right-4 items-center gap-3 p-3.5 rounded-2xl bg-[#0b0412]/85 border border-primary/35 backdrop-blur-xl shadow-2xl shadow-purple-dark/40 z-10">
            <div class="p-2 rounded-xl bg-primary/15 border border-primary/25 text-purple-light">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-body font-semibold text-xs text-white tracking-wide">Mini Sites & Bio</p>
              <p class="font-body text-[10px] text-purple-light/70">Otimizados para Converter</p>
            </div>
          </div>

        </div>

        <!-- DADOS E PILARES DE NEGÓCIO (Mesmo padrão do Stats do Minisite) -->
        <div class="w-full pt-8 mt-8 border-t border-primary/20 grid grid-cols-3 gap-4 text-center">
          <div class="relative">
            <p class="font-heading lining-nums font-semibold text-2xl sm:text-[28px] text-white leading-none">100%</p>
            <p class="font-body text-[10px] sm:text-[11px] uppercase tracking-[0.14em] text-purple-light/70 mt-2">Otimizado para Mobile</p>
          </div>
          <div class="relative">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 h-8 w-px bg-linear-to-b from-transparent via-primary/35 to-transparent"></div>
            <p class="font-heading lining-nums font-semibold text-2xl sm:text-[28px] text-accent leading-none drop-shadow-[0_0_12px_rgba(154,70,242,0.35)]">SaaS + Web</p>
            <p class="font-body text-[10px] sm:text-[11px] uppercase tracking-[0.14em] text-purple-light/70 mt-2">Tecnologia Própria</p>
            <div class="absolute right-0 top-1/2 -translate-y-1/2 h-8 w-px bg-linear-to-b from-transparent via-primary/35 to-transparent"></div>
          </div>
          <div class="relative">
            <p class="font-heading lining-nums font-semibold text-2xl sm:text-[28px] text-white leading-none">Ultra Fast</p>
            <p class="font-body text-[10px] sm:text-[11px] uppercase tracking-[0.14em] text-purple-light/70 mt-2">Carregamento Rápido</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  .animate-bounce-slow {
    animation: float 4s ease-in-out infinite;
  }
</style>