---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import mockupImg from '../assets/mockup.png'; 
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
  <!-- Efeito de brilho de fundo (Glow Effect) -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-accent/15 blur-[140px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- COLUNA DA ESQUERDA: TEXTOS E CTA -->
      <div class="lg:col-span-7 text-center lg:text-left">
        
        <!-- BADGE / TAG SUPERIOR -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-accent/40 bg-purple-dark/30 text-purple-light text-xs font-heading font-semibold uppercase tracking-wider mb-6">
          <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
          </svg>
          Soluções Digitais
        </div>

        <!-- TÍTULO PRINCIPAL -->
        <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
          Transforme visitantes em clientes com um <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-primary to-purple-light">site profissional</span>
        </h1>

        <!-- SUBTÍTULO / DESCRIÇÃO -->
        <p class="font-body text-gray-light text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          Landing Pages, Sites Institucionais e Lojas Virtuais de alta performance, projetados para destacar sua marca, gerar autoridade e acelerar suas vendas.
        </p>

        <!-- BOTÕES DE AÇÃO -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="https://wa.me/55SEUNUMERO" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-gradient-to-r from-primary to-accent hover:opacity-90 text-white font-heading font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-primary/25 hover:shadow-accent/40 transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <!-- Ícone do WhatsApp -->
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
            </svg>
            Solicitar Orçamento
          </a>

          <a
            href="#projetos"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-purple-dark bg-purple-dark/20 hover:bg-purple-dark/50 text-white font-heading font-semibold text-base px-6 py-4 rounded-xl transition-all"
          >
            Ver Projetos
          </a>
        </div>

      </div>

      <!-- COLUNA DA DIREITA: MOCKUP -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg lg:max-w-none">
          <!-- Brilho exclusivo atrás do mockup -->
          <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 to-accent/30 rounded-3xl blur-2xl -z-10 transform scale-95"></div>
          
          <Image 
            src={mockupImg} 
            alt="Mockup do site em notebook e smartphone" 
            class="w-full h-auto object-contain drop-shadow-[0_15px_30px_rgba(58,1,112,0.4)]"
            loading="eager"
          />
        </div>
      </div>

    </div>
  </div>
</section>