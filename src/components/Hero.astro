---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import mockupImg from '../assets/mockup.png'; 
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
  <!-- Padrão de Grid / Fundo Texturizado Sutil -->
  <div class="absolute inset-0 bg-[radial-gradient(#3a0170_1px,transparent_1px)] [background-size:24px_24px] opacity-20 -z-20 pointer-events-none"></div>

  <!-- Efeito de brilho de fundo (Glow Effect) -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/20 blur-[150px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- COLUNA DA ESQUERDA: TEXTOS, CTA E MÉTRICAS -->
      <div class="lg:col-span-7 text-center lg:text-left">
        
        <!-- BADGE SUPERIOR -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-accent/40 bg-purple-dark/30 backdrop-blur-md text-purple-light text-xs font-heading font-semibold uppercase tracking-wider mb-6 shadow-sm">
          <span class="flex h-2 w-2 rounded-full bg-accent animate-pulse"></span>
          Soluções Digitais & Web Design
        </div>

        <!-- TÍTULO PRINCIPAL -->
        <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.15] mb-6">
          Transforme visitantes em clientes com um <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-primary to-purple-light">site profissional</span>
        </h1>

        <!-- SUBTÍTULO / DESCRIÇÃO -->
        <p class="font-body text-gray-light text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          Landing Pages, Sites Institucionais e Lojas Virtuais de alta performance, projetados para destacar sua marca, gerar autoridade e acelerar suas vendas.
        </p>

        <!-- TAGS DE RECURSOS CHAVE (PILLS) -->
        <div class="flex flex-wrap justify-center lg:justify-start gap-2.5 mb-8 text-xs font-body text-gray-light">
          <span class="px-3 py-1.5 rounded-lg bg-purple-dark/20 border border-purple-dark/50 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Design Exclusivo
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-purple-dark/20 border border-purple-dark/50 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Velocidade Máxima
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-purple-dark/20 border border-purple-dark/50 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            Otimizado para SEO
          </span>
        </div>

        <!-- BOTÕES DE AÇÃO -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
          <a
            href="https://wa.me/55SEUNUMERO" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-gradient-to-r from-primary to-accent hover:opacity-95 text-white font-heading font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-primary/25 hover:shadow-accent/40 transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <!-- Ícone do WhatsApp -->
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
            </svg>
            Solicitar Orçamento
          </a>

          <a
            href="#projetos"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-purple-dark bg-purple-dark/20 hover:bg-purple-dark/50 text-white font-heading font-semibold text-base px-6 py-4 rounded-xl transition-all"
          >
            Ver Projetos
          </a>
        </div>

        <!-- BARRA DE PROVA SOCIAL / MÉTRICAS RÁPIDAS -->
        <div class="pt-6 border-t border-purple-dark/40 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0 text-center lg:text-left">
          <div>
            <p class="font-heading font-extrabold text-2xl text-white">100%</p>
            <p class="font-body text-xs text-gray-light">Responsivo e Mobile</p>
          </div>
          <div>
            <p class="font-heading font-extrabold text-2xl text-accent">+Vendas</p>
            <p class="font-body text-xs text-gray-light">Foco em Conversão</p>
          </div>
          <div>
            <p class="font-heading font-extrabold text-2xl text-white">Suporte</p>
            <p class="font-body text-xs text-gray-light">Acompanhamento Ativo</p>
          </div>
        </div>

      </div>

      <!-- COLUNA DA DIREITA: MOCKUP COM FLOATING BADGES -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg lg:max-w-none">
          
          <!-- Brilho exclusivo atrás do mockup -->
          <div class="absolute inset-0 bg-gradient-to-tr from-primary/40 to-accent/40 rounded-3xl blur-2xl -z-10 transform scale-95"></div>
          
          <!-- MOCKUP PRINCIPAL -->
          <Image 
            src={mockupImg} 
            alt="Mockup do site em notebook e smartphone" 
            class="w-full h-auto object-contain drop-shadow-[0_20px_35px_rgba(58,1,112,0.5)] transform hover:scale-[1.02] transition-transform duration-500"
            loading="eager"
          />

          <!-- FLOATING BADGE 1 (Topo Superior Esquerdo) -->
          <div class="hidden sm:flex absolute -top-4 -left-6 items-center gap-3 p-3 rounded-2xl bg-[#0a0a0a]/90 border border-purple-dark/80 backdrop-blur-md shadow-xl animate-bounce-slow">
            <div class="p-2 rounded-xl bg-accent/20 text-accent">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
              <p class="font-heading font-bold text-xs text-white">Performance 100%</p>
              <p class="font-body text-[10px] text-gray-light">Carregamento ultrarrápido</p>
            </div>
          </div>

          <!-- FLOATING BADGE 2 (Inferior Direito) -->
          <div class="hidden sm:flex absolute -bottom-4 -right-4 items-center gap-3 p-3 rounded-2xl bg-[#0a0a0a]/90 border border-purple-dark/80 backdrop-blur-md shadow-xl">
            <div class="p-2 rounded-xl bg-primary/20 text-purple-light">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="font-heading font-bold text-xs text-white">Layout Adaptativo</p>
              <p class="font-body text-[10px] text-gray-light">Perfeito em celulares</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Animação suave para a badge flutuante */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  .animate-bounce-slow {
    animation: float 4s ease-in-out infinite;
  }
</style>