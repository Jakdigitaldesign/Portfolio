---
// src/components/Projects.astro
import { Image } from 'astro:assets';

// Importes dos prints dos seus sites e plataformas
import printFoxped from '../assets/projetos/foxped.webp';
import printMinisite from '../assets/projetos/minisite.webp';
import printProjeto1 from '../assets/projetos/odontovita.webp';
import printProjeto2 from '../assets/projetos/universeTrade.webp';
import printProjeto3 from '../assets/projetos/rheoshelmet.webp';
import printProjeto4 from '../assets/projetos/curioverso.webp';
import printProjeto7 from '../assets/projetos/nexora-consultoria.webp';

const projects = [
  {
    title: 'Sistema Foxped',
    category: 'Site',
    image: printFoxped,
    url: 'https://foxped.com.br',
  },
  {
    title: 'Minisite Bio',
    category: 'Site',
    image: printMinisite,
    url: 'https://sites-bio.pages.dev/',
  },
  {
    title: 'Odonto Vita',
    category: 'Site',
    image: printProjeto1,
    url: 'https://odontovita.pages.dev/',
  },
  {
    title: 'Nexora Consultoria',
    category: 'Landing Page',
    image: printProjeto7,
    url: 'https://nexora-lp.pages.dev/',
  },
  {
    title: 'Universe Trade',
    category: 'Site',
    image: printProjeto2,
    url: 'https://universetrade.com.br/',
  },
  {
    title: 'Rheos Helmet',
    category: 'Loja',
    image: printProjeto3,
    url: 'https://rheoshelmet.com.br/',
  },
  {
    title: 'Curioverso',
    category: 'Blog',
    image: printProjeto4,
    url: 'https://blog.jakdigitaldesign.com/',
  },
] as const;

// Divide os projetos ao meio para criar 2 linhas contínuas
const metade = Math.ceil(projects.length / 2);
const linha1 = projects.slice(0, metade);
const linha2 = projects.slice(metade);

const speedSeconds = 35;
---

<section id="projetos" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CABEÇALHO DA SEÇÃO -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60 mb-4">
        Portfólio
      </span>
      <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-white mb-4">
        Projetos em <span class="text-accent">Destaque</span>
      </h2>
      <p class="font-body text-gray-light text-base sm:text-lg">
        Confira alguns dos trabalhos desenvolvidos: clique na foto para ampliar ou acesse o site diretamente.
      </p>
    </div>

    <!-- WRAPPER DO CARROSSEL DE 2 LINHAS (MARQUEE) -->
    <div class="marquee-wrapper flex flex-col gap-6 w-full overflow-hidden group py-2">
      
      <!-- LINHA 1: Desliza para a Esquerda -->
      {linha1.length > 0 && (
        <div 
          class="marquee-track track-1 flex gap-6 w-max"
          style={`--speed: ${speedSeconds}s;`}
        >
          {linha1.concat(linha1).map((project) => (
            <div class="project-card relative w-80 sm:w-96 bg-[#0a0a0a]/80 border border-purple-dark/60 rounded-2xl overflow-hidden shadow-lg backdrop-blur-md shrink-0 flex flex-col group/card transition-all duration-300 hover:border-accent/80">
              <!-- Área da Imagem Clicável (Abre Lightbox) -->
              <div 
                class="photo-clickable relative h-48 sm:h-52 w-full overflow-hidden cursor-pointer"
                data-fullsrc={project.image.src}
                data-title={project.title}
              >
                <Image 
                  src={project.image} 
                  alt={project.title}
                  width={600}
                  height={350}
                  format="webp"
                  fit="cover"
                  position="top"
                  loading="lazy"
                  class="w-full h-full object-cover object-top! transition-transform duration-500 group-hover/card:scale-105"
                />
                <div class="absolute inset-0 bg-linear-to-t from-[#0a0a0a] via-transparent to-transparent opacity-80"></div>
                
                <!-- Badge de Categoria -->
                <span class="absolute top-3 left-3 bg-purple-dark/80 backdrop-blur-md text-accent text-[11px] font-semibold px-3 py-1 rounded-full border border-purple-dark">
                  {project.category}
                </span>

                <!-- Overlay para Dica de Clique -->
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <span class="text-white text-xs font-semibold bg-black/70 px-3 py-1.5 rounded-lg border border-white/20 backdrop-blur-sm flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                    Clique para ampliar
                  </span>
                </div>
              </div>

              <!-- Info do Projeto & Botão Ver Online -->
              <div class="p-5 flex flex-col justify-between flex-1">
                <div>
                  <h3 class="font-heading text-center font-bold text-lg text-white mb-1 group-hover/card:text-accent transition-colors">
                    {project.title}
                  </h3>
                  
                </div>

                <a 
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-purple-dark/40 hover:bg-accent border border-purple-dark/80 hover:border-accent text-white font-heading font-semibold text-xs transition-all duration-300 group/btn"
                >
                  Ver Online
                  <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- LINHA 2: Desliza para a Direita -->
      {linha2.length > 0 && (
        <div 
          class="marquee-track track-2 flex gap-6 w-max"
          style={`--speed: ${speedSeconds}s;`}
        >
          {linha2.concat(linha2).map((project) => (
            <div class="project-card relative w-80 sm:w-96 bg-[#0a0a0a]/80 border border-purple-dark/60 rounded-2xl overflow-hidden shadow-lg backdrop-blur-md shrink-0 flex flex-col group/card transition-all duration-300 hover:border-accent/80">
              <!-- Área da Imagem Clicável (Abre Lightbox) -->
              <div 
                class="photo-clickable relative h-48 sm:h-52 w-full overflow-hidden cursor-pointer"
                data-fullsrc={project.image.src}
                data-title={project.title}
              >
                <Image 
                  src={project.image} 
                  alt={project.title}
                  width={600}
                  height={350}
                  format="webp"
                  loading="lazy"
                  fit="cover"
                  position="top"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-105"
                />
                <div class="absolute inset-0 bg-linear-to-t from-[#0a0a0a] via-transparent to-transparent opacity-80"></div>
                
                <!-- Badge de Categoria -->
                <span class="absolute top-3 left-3 bg-purple-dark/80 backdrop-blur-md text-accent text-[11px] font-semibold px-3 py-1 rounded-full border border-purple-dark">
                  {project.category}
                </span>

                <!-- Overlay para Dica de Clique -->
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <span class="text-white text-xs font-semibold bg-black/70 px-3 py-1.5 rounded-lg border border-white/20 backdrop-blur-sm flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                    Clique para ampliar
                  </span>
                </div>
              </div>

              <!-- Info do Projeto & Botão Ver Online -->
              <div class="p-5 flex flex-col justify-between flex-1">
                <div>
                  <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover/card:text-accent transition-colors">
                    {project.title}
                  </h3>
                  
                </div>

                <a 
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-purple-dark/40 hover:bg-accent border border-purple-dark/80 hover:border-accent text-white font-heading font-semibold text-xs transition-all duration-300 group/btn"
                >
                  Ver Online
                  <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      )}

    </div>

    <!-- BOTÃO VER TODOS -->
    <div class="mt-12 text-center">
      <a
        href="/projetos"
        class="inline-flex items-center gap-2 border border-accent bg-purple-dark/30 hover:bg-accent text-white font-heading font-semibold text-base px-8 py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-accent/30"
      >
        Ver Todos os Projetos
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>

  <!-- LIGHTBOX MODAL AMPLIAÇÃO -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8 transition-opacity">
    <button type="button" class="lightbox-close absolute top-5 right-6 text-white/70 hover:text-white text-4xl font-light cursor-pointer z-50 leading-none">&times;</button>
    <div class="relative max-w-5xl max-h-[90vh] flex flex-col items-center">
      <img class="max-w-full max-h-[80vh] rounded-xl object-contain shadow-2xl border border-purple-dark/50" id="lightbox-img" alt="Projeto ampliado" />
      <p id="lightbox-caption" class="text-white font-heading font-semibold text-lg mt-4 text-center"></p>
    </div>
  </div>
</section>

<!-- SCRIPT DO LIGHTBOX -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.querySelector('.lightbox-close');
    const clickablePhotos = document.querySelectorAll('.photo-clickable');

    if (!modal || !modalImg) return;

    clickablePhotos.forEach((card) => {
      card.addEventListener('click', () => {
        const fullSrc = card.getAttribute('data-fullsrc');
        const title = card.getAttribute('data-title');
        if (fullSrc) {
          modalImg.src = fullSrc;
          if (modalCaption && title) modalCaption.textContent = title;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>

<style>
  /* Animações continuas CSS */
  .track-1 {
    animation: scrollLeft var(--speed, 35s) linear infinite;
  }

  .track-2 {
    animation: scrollRight var(--speed, 35s) linear infinite;
  }

  /* Pausa a animação ao passar o mouse */
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
</style>