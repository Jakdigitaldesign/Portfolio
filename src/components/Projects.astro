---
// src/components/Projects.astro
import ProjectCard from './ProjectCard.astro';

// Importes dos prints dos seus sites e plataformas
import printFoxped from '../assets/projetos/foxped.webp'; // Crie ou adicione a imagem do Foxped
import printMinisite from '../assets/projetos/minisite.webp'; // Crie ou adicione a imagem do Minisite
import printProjeto1 from '../assets/projetos/odontovita.webp';
import printProjeto2 from '../assets/projetos/universeTrade.webp';
import printProjeto3 from '../assets/projetos/rheoshelmet.webp';
import printProjeto4 from '../assets/projetos/curioverso.webp';
import printProjeto7 from '../assets/projetos/nexora-consultoria.webp';

const projects = [
  {
    title: 'Sistema Foxped',
    category: 'SaaS / Plataforma',
    description: 'Cardápio digital e automação de pedidos para restaurantes via WhatsApp.',
    image: printFoxped,
    url: 'https://foxped.com.br', // Substitua pelo link correto do Foxped
  },
  {
    title: 'Minisite Bio',
    category: 'Link na Bio',
    description: 'Cartão de visitas digital moderno e estratégico para redes sociais.',
    image: printMinisite,
    url: 'https://sites-bio.pages.dev/', // Substitua pelo link correto do Minisite
  },
  {
    title: 'Odonto Vita',
    category: 'Site Institutional',
    description: 'Site para clínica odontológica focado na conversão de agendamentos.',
    image: printProjeto1,
    url: 'https://odontovita.pages.dev/',
  },
  {
    title: 'Nexora Consultoria',
    category: 'Landing Page',
    description: 'Página de alta conversão para captura de leads e venda de infoproduto.',
    image: printProjeto7,
    url: 'https://nexora-lp.pages.dev/',
  },
  {
    title: 'Universe Trade',
    category: 'Site Institutional',
    description: 'Presença digital corporativa para empresa de investimentos.',
    image: printProjeto2,
    url: 'https://universetrade.com.br/',
  },
  {
    title: 'Rheos Helmet',
    category: 'Loja Virtual',
    description: 'E-commerce completo com catálogo de produtos e checkout fluido.',
    image: printProjeto3,
    url: 'https://rheoshelmet.com.br/',
  },
  {
    title: 'Curioverso',
    category: 'Blog & Conteúdo',
    description: 'Portal de notícias e artigos com estrutura otimizada para SEO.',
    image: printProjeto4,
    url: 'https://blog.jakdigitaldesign.com/',
  },
];
---

<section id="projetos" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CABEÇALHO DA SEÇÃO -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60 mb-4">
        Portfólio
      </span>
      <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-white mb-4">
        Projetos em <span class="text-accent">Destaque</span>
      </h2>
      <p class="font-body text-gray-light text-base sm:text-lg">
        Confira alguns dos trabalhos desenvolvidos: de plataformas SaaS e minisites a landing pages e e-commerces.
      </p>
    </div>

    <!-- CONTÊINER RELATIVO PARA POSICIONAR AS SETAS NAS LATERAIS -->
    <div class="relative group">
      
      <!-- SETA ESQUERDA -->
      <button
        id="prev-project"
        type="button"
        aria-label="Projeto anterior"
        class="absolute -left-4 sm:-left-6 top-1/2 -translate-y-1/2 z-20 p-3 rounded-full border border-purple-dark/80 bg-bg-dark/90 text-white hover:bg-primary hover:border-transparent transition-all duration-300 shadow-xl backdrop-blur-md focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- CARROSSEL RESPONSIVO (SCROLL SNAP) -->
      <div
        id="projects-carousel"
        class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar pb-6 pt-2"
      >
        {projects.map((project) => (
          <div class="snap-start shrink-0 w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
            <ProjectCard
              title={project.title}
              category={project.category}
              description={project.description}
              image={project.image}
              url={project.url}
            />
          </div>
        ))}
      </div>

      <!-- SETA DIREITA -->
      <button
        id="next-project"
        type="button"
        aria-label="Próximo projeto"
        class="absolute -right-4 sm:-right-6 top-1/2 -translate-y-1/2 z-20 p-3 rounded-full border border-purple-dark/80 bg-bg-dark/90 text-white hover:bg-primary hover:border-transparent transition-all duration-300 shadow-xl backdrop-blur-md focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

    </div>

    <!-- BOTÃO VER TODOS -->
    <div class="mt-12 text-center">
      <a
        href="/projetos"
        class="inline-flex items-center gap-2 border border-accent bg-purple-dark/30 hover:bg-accent text-white font-heading font-semibold text-base px-8 py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-accent/30"
      >
        Ver Todos os Projetos
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- ESTILO PARA OCULTAR A BARRA DE ROLAGEM PADRÃO DO CARROSSEL -->
<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<!-- SCRIPT DE NAVEGAÇÃO -->
<script>
  const carousel = document.getElementById('projects-carousel');
  const prevBtn = document.getElementById('prev-project');
  const nextBtn = document.getElementById('next-project');

  if (carousel && prevBtn && nextBtn) {
    const scrollAmount = () => {
      const firstCard = carousel.querySelector('div');
      return firstCard ? firstCard.clientWidth + 24 : 350;
    };

    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  }
</script>