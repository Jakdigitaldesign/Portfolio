---
// src/components/Services.astro

const services = [
  {
    title: "LANDING PAGES",
    description: "Páginas estratégicas focadas em conversão para vender produtos, serviços ou captar leads.",
    features: [
      "Estrutura persuasiva",
      "Design responsivo",
      "Ideal para anúncios",
      "Botão de WhatsApp integrado"
    ],
    highlight: false, // Card padrão
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />` // Ícone de raio / conversão
  },
  {
    title: "SITES INSTITUCIONAIS",
    description: "Presença digital profissional para apresentar sua empresa com clareza e credibilidade.",
    features: [
      "Site one page ou multi page",
      "Design personalizado",
      "Desenvolvimento em Astro / WP",
      "Estrutura otimizada para SEO"
    ],
    highlight: true, // Destaque central
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />` // Ícone do globo / web
  },
  {
    title: "LOJA VIRTUAL",
    description: "Venda seus produtos online com uma loja segura, profissional e pronta para escalar.",
    features: [
      "WooCommerce ou Nuvemshop",
      "Configuração completa",
      "Seus produtos cadastrados",
      "Pagamentos e frete ativos"
    ],
    highlight: false,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />` // Ícone da sacola de compras
  }
];
---

<section id="servicos" class="py-20 md:py-28 relative">
  <!-- Brilho sutil no fundo -->
  <div class="absolute top-1/2 right-0 w-[400px] h-[400px] bg-primary/10 blur-[130px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CABEÇALHO DA SEÇÃO -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60">
        Serviços
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-4 mb-6 leading-tight">
        Soluções digitais para cada etapa do seu crescimento
      </h2>
      <p class="font-body text-gray-light text-base sm:text-lg">
        Se você ainda não tem site ou sente que sua presença online não transmite profissionalismo, aqui está a solução ideal para o seu momento.
      </p>
    </div>

    <!-- GRID DE CARDS DOS SERVIÇOS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {services.map((service) => (
        <div 
          class={`relative flex flex-col justify-between p-8 rounded-2xl transition-all duration-300 group border ${
            service.highlight 
              ? 'bg-gradient-to-b from-purple-dark/60 via-bg-dark to-bg-dark border-accent/60 shadow-xl shadow-accent/10 lg:-translate-y-2' 
              : 'bg-bg-dark/80 border-purple-dark/50 hover:border-primary/60 hover:bg-purple-dark/20'
          }`}
        >
          <!-- Badge 'Mais Procurado' para o card em destaque -->
          {service.highlight && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-accent text-white text-[11px] font-heading font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md">
              Mais Solicitado
            </div>
          )}

          <div>
            <!-- ÍCONE -->
            <div class="w-14 h-14 rounded-xl bg-purple-dark/60 border border-primary/30 flex items-center justify-center text-accent mb-6 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={service.icon} />
            </div>

            <!-- TÍTULO -->
            <h3 class="font-heading font-bold text-xl text-white tracking-wider mb-3">
              {service.title}
            </h3>

            <!-- DESCRIÇÃO -->
            <p class="font-body text-gray-light text-sm mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- LISTA DE CARACTERÍSTICAS -->
            <ul class="space-y-3 mb-8">
              {service.features.map((feature) => (
                <li class="flex items-center gap-3 font-body text-sm text-gray-light">
                  <div class="w-5 h-5 rounded-full bg-accent/20 flex items-center justify-center shrink-0 text-accent">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- BOTÃO SABER MAIS -->
          <a
            href="https://wa.me/5541984940848?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20o%20serviço%20de%20"
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full text-center font-heading font-bold text-xs uppercase tracking-wider py-3.5 px-4 rounded-xl transition-all duration-300 border flex items-center justify-center gap-2 ${
              service.highlight
                ? 'bg-primary hover:bg-accent text-white border-transparent shadow-md shadow-primary/20'
                : 'bg-purple-dark/30 hover:bg-primary border-purple-dark/60 hover:border-transparent text-white'
            }`}
          >
            Saber Mais
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

        </div>
      ))}
    </div>

  </div>
</section>