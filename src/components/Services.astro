---
// src/components/Services.astro

const services = [
  {
    title: "Links na Bio",
    subtitle: "Minisites para Redes Sociais",
    tag: "Sob Medida",
    description: "Hub centralizado de links e autoridade para converter seguidores em clientes.",
    features: [
      "Design 100% alinhado à sua marca",
      "Sessões ilimitadas de conteúdo",
      "Carregamento ultra-rápido",
      "Botões diretos para conversão"
    ],
    highlight: false,
    badge: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />`
  },
  {
    title: "Sistema Foxped",
    subtitle: "Cardápio Digital & SaaS",
    tag: "Plataforma SaaS",
    description: "Gestão completa de pedidos para restaurantes e delivery sem comissões por venda.",
    features: [
      "Cardápio interativo via QR Code",
      "Gestão de pedidos em tempo real",
      "Pagamentos online integrados",
      "Sem intermediários ou taxas"
    ],
    highlight: true,
    badge: "Solução Própria",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`
  },
  {
    title: "Landing Pages",
    subtitle: "Páginas de Alta Conversão",
    tag: "Foco em Vendas",
    description: "Páginas estratégicas e ultra-rápidas desenhadas para campanhas de tráfego pago.",
    features: [
      "Arquitetura focada em conversão",
      "Desenvolvimento em tecnologia Astro",
      "SEO técnico pré-configurado",
      "Integração rápida com CRM/WhatsApp"
    ],
    highlight: false,
    badge: "Mais Solicitado",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />`
  },
  {
    title: "Lojas Virtuais",
    subtitle: "E-commerce de Alta Performance",
    tag: "Pronta para Vender",
    description: "Plataforma completa de vendas com gestão simplificada de catálogo e frete.",
    features: [
      "Checkout seguro e intuitivo",
      "Cálculo automático de frete",
      "Gestão simples de estoque",
      "Painel administrativo moderno"
    ],
    highlight: false,
    badge: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`
  }
];
---

<section id="servicos" class="py-16 md:py-24 relative font-body">
  <!-- Brilho sutil no fundo -->
  <div class="absolute top-1/2 right-0 w-96 h-96 bg-purple-dark/30 blur-[140px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CABEÇALHO DA SEÇÃO -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <div class="font-body inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/35 bg-primary/15 backdrop-blur-md text-purple-light text-[11px] font-medium uppercase tracking-[0.2em]">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        Nossos Serviços
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-white mt-5 mb-4 leading-[1.08] tracking-tight">
        Soluções focadas no{" "}
        <span class="italic text-transparent bg-clip-text bg-linear-to-r from-purple-light via-accent to-primary pr-1">
          crescimento
        </span>{" "}
        do seu negócio
      </h2>

      <!-- Divisória Gradiente Minimalista -->
      <div class="h-px w-36 bg-linear-to-r from-transparent via-accent/55 to-transparent mx-auto my-4"></div>

      <p class="font-body text-purple-light/75 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Do posicionamento estratégico nas redes sociais até plataformas completas de vendas online.
      </p>
    </div>

    <!-- GRID DE CARDS DOS SERVIÇOS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {services.map((service) => (
        <div
          class={`relative flex flex-col justify-between p-6 rounded-3xl transition-all duration-300 group border backdrop-blur-xl ${
            service.highlight
              ? 'bg-linear-to-b from-[#19082c]/95 via-[#0d0418]/95 to-[#0b0412]/95 border-accent/65 shadow-[0_16px_44px_rgba(131,67,195,0.22)] lg:-translate-y-2'
              : 'bg-[#0b0412]/85 border-primary/25 hover:border-accent/55 hover:bg-[#120720]/90 shadow-xl shadow-purple-dark/15 hover:-translate-y-1'
          }`}
        >
          <!-- Badge Superior do Card -->
          {service.badge && (
            <div class="font-body absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 bg-[#120620] text-purple-light text-[10px] font-medium uppercase tracking-[0.16em] px-3 py-0.5 rounded-full shadow-lg border border-accent/55 whitespace-nowrap">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              {service.badge}
            </div>
          )}

          <div>
            <!-- Topo com ícone e etiqueta -->
            <div class="flex items-center justify-between mb-5">
              <div
                class={`w-11 h-11 rounded-xl border flex items-center justify-center transition-all duration-300 ${
                  service.highlight
                    ? 'bg-accent/15 border-accent/40 text-accent group-hover:bg-accent group-hover:text-white'
                    : 'bg-white/4 border-primary/25 text-accent group-hover:bg-accent/15 group-hover:border-accent/50 group-hover:text-white'
                }`}
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={service.icon} />
              </div>

              <span class="font-body text-[10px] uppercase font-medium tracking-[0.14em] text-purple-light/85 bg-white/4 px-2.5 py-1 rounded-full border border-primary/25">
                {service.tag}
              </span>
            </div>

            <!-- TÍTULO & SUBTÍTULO -->
            <h3 class="font-heading font-semibold text-2xl text-white tracking-wide leading-tight">
              {service.title}
            </h3>

            <div class="flex items-center gap-2 mt-1.5 mb-3">
              <span class="w-3 h-[1.5px] bg-accent rounded-full shrink-0"></span>
              <p class="font-body text-[11px] text-purple-light/80 font-medium uppercase tracking-[0.12em]">
                {service.subtitle}
              </p>
            </div>

            <!-- DESCRIÇÃO -->
            <p class="font-body text-gray-light/80 text-xs leading-relaxed">
              {service.description}
            </p>

            <!-- Divisória Sutil -->
            <div class="h-px w-full bg-linear-to-r from-transparent via-primary/30 to-transparent my-4"></div>

            <!-- LISTA DE CARACTERÍSTICAS -->
            <ul class="space-y-2.5 mb-6">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2.5 font-body text-xs text-purple-light/80">
                  <div class="w-4 h-4 rounded-full bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0 text-accent mt-0.5">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <span class="leading-snug">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- BOTÃO CTA -->
          <a
            href={`https://wa.me/5541984940848?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20o%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`font-body w-full text-center font-semibold text-[11px] uppercase tracking-[0.16em] py-3.5 px-4 rounded-xl transition-all duration-300 border flex items-center justify-center gap-2 group/btn ${
              service.highlight
                ? 'bg-linear-to-r from-primary to-accent hover:brightness-110 text-white border-transparent shadow-[0_8px_24px_rgba(131,67,195,0.35)] hover:shadow-[0_10px_28px_rgba(154,70,242,0.5)]'
                : 'bg-white/4 hover:bg-primary/20 border-primary/30 hover:border-accent/60 text-purple-light hover:text-white'
            }`}
          >
            <span>Solicitar Proposta</span>
            <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

        </div>
      ))}
    </div>

  </div>
</section>