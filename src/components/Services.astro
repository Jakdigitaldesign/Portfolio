---
// src/components/Services.astro

const services = [
  {
    title: "LINKS NA BIO",
    subtitle: "Minisites Personalizados",
    price: "R$ 39,99",
    priceDetail: "pagamento único",
    description: "Cartão de visitas digital moderno para Instagram e redes sociais. Você escolhe o modelo e nós personalizamos.",
    features: [
      "Modelos 100% editáveis",
      "Links ilimitados e botões",
      "Entrega rápida e otimizada",
      "Ideal para autônomos e marcas"
    ],
    highlight: false,
    badge: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />`
  },
  {
    title: "SISTEMA FOXPED",
    subtitle: "Cardápio Digital & SaaS",
    price: "R$ 39,99",
    priceDetail: "/mês",
    description: "Plataforma completa para restaurantes e delivery automatizarem pedidos do WhatsApp sem taxas por venda.",
    features: [
      "Robô de automação WhatsApp",
      "Painel de pedidos em Kanban",
      "Relatórios de vendas claros",
      "Pagamento Mercado Pago integrado"
    ],
    highlight: true,
    badge: "Plataforma SaaS",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`
  },
  {
    title: "LANDING PAGES & SITES",
    subtitle: "Presença Web de Alta Conversão",
    price: "Sob Consulta",
    priceDetail: "projeto personalizado",
    description: "Sites institucionais e páginas de vendas sob medida para transmitir autoridade e captar clientes em escala.",
    features: [
      "Design 100% exclusivo",
      "Desenvolvimento ultra-rápido (Astro)",
      "Estrutura otimizada para SEO",
      "Integrações e WhatsApp direto"
    ],
    highlight: false,
    badge: "Mais Solicitado",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />`
  },
  {
    title: "LOJAS VIRTUAIS",
    subtitle: "E-commerce Completo",
    price: "Sob Consulta",
    priceDetail: "pronta para vender",
    description: "Sua loja online profissional para expor produtos, gerenciar estoque e receber pagamentos de forma simples.",
    features: [
      "WooCommerce / Nuvemshop",
      "Cadastro dos seus produtos",
      "Cálculo de frete automático",
      "Checkout seguro e fluido"
    ],
    highlight: false,
    badge: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`
  }
];
---

<section id="servicos" class="py-20 md:py-28 relative">
  <!-- Brilho sutil no fundo -->
  <div class="absolute top-1/2 right-0 w-[400px] h-[400px] bg-primary/10 blur-[130px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CABEÇALHO DA SEÇÃO -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60">
        Soluções Digitais
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-4 mb-6 leading-tight">
        Tudo o que seu negócio precisa para crescer online
      </h2>
      <p class="font-body text-gray-light text-base sm:text-lg">
        Seja para criar um link de bio simples, automatizar seu restaurante com o Foxped ou construir um site de alto padrão.
      </p>
    </div>

    <!-- GRID DE CARDS DOS SERVIÇOS (4 COLUNAS EM TELAS GRANDES) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {services.map((service) => (
        <div 
          class={`relative flex flex-col justify-between p-6 sm:p-7 rounded-2xl transition-all duration-300 group border ${
            service.highlight 
              ? 'bg-gradient-to-b from-purple-dark/60 via-bg-dark to-bg-dark border-accent/70 shadow-xl shadow-accent/10 lg:-translate-y-2' 
              : 'bg-bg-dark/80 border-purple-dark/50 hover:border-primary/60 hover:bg-purple-dark/20'
          }`}
        >
          <!-- Badge Superior do Card -->
          {service.badge && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-accent text-white text-[10px] font-heading font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md whitespace-nowrap">
              {service.badge}
            </div>
          )}

          <div>
            <!-- ÍCONE -->
            <div class="w-12 h-12 rounded-xl bg-purple-dark/60 border border-primary/30 flex items-center justify-center text-accent mb-5 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={service.icon} />
            </div>

            <!-- TÍTULO & SUBTÍTULO -->
            <h3 class="font-heading font-bold text-lg text-white tracking-wide mb-1">
              {service.title}
            </h3>
            <p class="font-body text-xs text-purple-light font-medium mb-4">
              {service.subtitle}
            </p>

            <!-- PREÇO / INVESTIMENTO -->
            <div class="mb-5 p-3 rounded-xl bg-purple-dark/20 border border-purple-dark/40">
              <span class="font-heading font-extrabold text-xl text-white block">
                {service.price}
              </span>
              <span class="font-body text-[11px] text-gray-light">
                {service.priceDetail}
              </span>
            </div>

            <!-- DESCRIÇÃO -->
            <p class="font-body text-gray-light text-xs mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- LISTA DE CARACTERÍSTICAS -->
            <ul class="space-y-2.5 mb-8">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2.5 font-body text-xs text-gray-light">
                  <div class="w-4 h-4 rounded-full bg-accent/20 flex items-center justify-center shrink-0 text-accent mt-0.5">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- BOTÃO SABER MAIS COM MENSAGEM DINÂMICA -->
          <a
            href={`https://wa.me/5541984940848?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20o%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full text-center font-heading font-bold text-xs uppercase tracking-wider py-3.5 px-4 rounded-xl transition-all duration-300 border flex items-center justify-center gap-2 ${
              service.highlight
                ? 'bg-primary hover:bg-accent text-white border-transparent shadow-md shadow-primary/20'
                : 'bg-purple-dark/30 hover:bg-primary border-purple-dark/60 hover:border-transparent text-white'
            }`}
          >
            Quero Contratar
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

        </div>
      ))}
    </div>

  </div>
</section>