---
// src/components/Services.astro

const services = [
  {
    title: "LINKS NA BIO",
    subtitle: "Minisites para Redes Sociais",
    tag: "Sob Medida",
    description: "Hub centralizado de links e autoridade para converter seguidores em clientes.",
    features: [
      "Design 100% alinhado à sua marca",
      "Sessões ilimitadas de conteúdo",
      "Carregamento ultra-rápido",
      "Botões diretos para conversão"
    ],
    highlight: false,
    badge: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />`
  },
  {
    title: "SISTEMA FOXPED",
    subtitle: "Cardápio Digital & SaaS",
    tag: "Plataforma SaaS",
    description: "Gestão completa de pedidos para restaurantes e delivery sem comissões por venda.",
    features: [
      "Cardápio interativo via QR Code",
      "Gestão de pedidos em tempo real",
      "Pagamentos online integrados",
      "Sem intermediários ou taxas"
    ],
    highlight: true,
    badge: "Solução Própria",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`
  },
  {
    title: "LANDING PAGES",
    subtitle: "Páginas de Alta Conversão",
    tag: "Foco em Vendas",
    description: "Páginas estratégicas e ultra-rápidas desenhadas para campanhas de tráfego pago.",
    features: [
      "Arquitetura focada em conversão",
      "Desenvolvimento em tecnologia Astro",
      "SEO técnico pré-configurado",
      "Integração rápida com CRM/WhatsApp"
    ],
    highlight: false,
    badge: "Mais Solicitado",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />`
  },
  {
    title: "LOJAS VIRTUAIS",
    subtitle: "E-commerce de Alta Performance",
    tag: "Pronta para Vender",
    description: "Plataforma completa de vendas com gestão simplificada de catálogo e frete.",
    features: [
      "Checkout seguro e intuitivo",
      "Cálculo automático de frete",
      "Gestão simples de estoque",
      "Painel administrativo moderno"
    ],
    highlight: false,
    badge: null,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`
  }
];
---

<section id="servicos" class="py-16 md:py-24 relative">
  <!-- Brilho sutil no fundo -->
  <div class="absolute top-1/2 right-0 w-96 h-96 bg-primary/10 blur-[130px] rounded-full -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CABEÇALHO DA SEÇÃO -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="font-heading text-xs font-semibold uppercase tracking-widest text-accent bg-purple-dark/40 px-4 py-1.5 rounded-full border border-purple-dark/60">
        Nossos Serviços
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mt-4 mb-4 leading-tight">
        Soluções focadas no crescimento do seu negócio
      </h2>
      <p class="font-body text-gray-light text-sm sm:text-base">
        Do posicionamento estratégico nas redes sociais até plataformas completas de vendas online.
      </p>
    </div>

    <!-- GRID DE CARDS DOS SERVIÇOS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {services.map((service) => (
        <div 
          class={`relative flex flex-col justify-between p-5 sm:p-6 rounded-2xl transition-all duration-300 group border ${
            service.highlight 
              ? 'bg-linear-to-b from-purple-dark/60 via-bg-dark to-bg-dark border-accent/70 shadow-xl shadow-accent/10 lg:-translate-y-2' 
              : 'bg-bg-dark/80 border-purple-dark/50 hover:border-primary/60 hover:bg-purple-dark/20'
          }`}
        >
          <!-- Badge Superior do Card -->
          {service.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-accent text-white text-[10px] font-heading font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-md whitespace-nowrap">
              {service.badge}
            </div>
          )}

          <div>
            <!-- topo com ícone e etiqueta -->
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-purple-dark/60 border border-primary/30 flex items-center justify-center text-accent group-hover:scale-105 group-hover:bg-primary group-hover:text-white transition-all duration-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={service.icon} />
              </div>
              <span class="text-[10px] font-heading uppercase font-semibold text-purple-light bg-purple-dark/40 px-2.5 py-1 rounded-md border border-purple-dark/60">
                {service.tag}
              </span>
            </div>

            <!-- TÍTULO & SUBTÍTULO -->
            <h3 class="font-heading font-bold text-base sm:text-lg text-white tracking-wide">
              {service.title}
            </h3>
            <p class="font-body text-xs text-purple-light font-medium mb-3">
              {service.subtitle}
            </p>

            <!-- DESCRIÇÃO -->
            <p class="font-body text-gray-light text-xs mb-5 leading-relaxed">
              {service.description}
            </p>

            <!-- LISTA DE CARACTERÍSTICAS -->
            <ul class="space-y-2 mb-6">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2 font-body text-xs text-gray-light">
                  <div class="w-3.5 h-3.5 rounded-full bg-accent/20 flex items-center justify-center shrink-0 text-accent mt-0.5">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <span class="leading-tight">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- BOTÃO COM CTA CLARO -->
          <a
            href={`https://wa.me/5541984940848?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20o%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full text-center font-heading font-bold text-xs uppercase tracking-wider py-3 px-4 rounded-xl transition-all duration-300 border flex items-center justify-center gap-2 ${
              service.highlight
                ? 'bg-primary hover:bg-accent text-white border-transparent shadow-md shadow-primary/20'
                : 'bg-purple-dark/30 hover:bg-primary border-purple-dark/60 hover:border-transparent text-white'
            }`}
          >
            Solicitar Proposta
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

        </div>
      ))}
    </div>

  </div>
</section>