---
import Layout from '../layouts/Layout.astro';
import BioHeaderDark from '../components/Bio/BioHeaderDark.astro';
import BioStatsDark from '../components/Bio/BioStatsDark.astro';
import BioLinksDark from '../components/Bio/BioLinksDark.astro';
import TestimonialsCarousel, { type TestimonialItem } from '../components/Bio/TestimonialsCarousel.astro';
import FaqSection from '../components/Bio/FaqSection.astro';
import BioFooterDark from '../components/Bio/BioFooterDark.astro';

// 1. IMPORTAÇÃO DO NOVO COMPONENTE DE GALERIA
import BioTabbedGallery from '../components/Bio/BioProjectsGalleryDark.astro'; 

// Imagens Gerais
import logo from '../assets/Logo.png';
import avatarImg from '../assets/jak.png';

const testimonials: TestimonialItem[] = [
  {
    quote: 'Profissional excelente! Muito atenciosa, ágil e totalmente dedicada ao projeto. Fiquei extremamente satisfeito com o resultado final.',
    authorName: 'Rafael Mendes',
    authorRole: 'Projeto sob medida',
    projectType: 'Site / Landing',
    rating: 5
  },
  {
    quote: 'Ah, maravilha, Jaque! Ficou ótimo, amei o resultado ☺️',
    authorName: 'Camila Rocha',
    authorRole: 'Atendimento integrativo',
    projectType: 'Minisite',
    rating: 5
  },
  {
    quote: 'Gostei muito, ficou ótimo o meu mini site! Super prático e bonito. Recomendo demais o trabalho da Jaqueline.',
    authorName: 'Mariana Costa',
    authorRole: 'Profissional autônoma',
    projectType: 'Minisite',
    rating: 5
  },
  {
    quote: 'Minha loja ficou com um visual muito profissional! Gostei bastante do serviço e a entrega foi bem rápida.',
    authorName: 'Lucas Martins',
    authorRole: 'Varejo online',
    projectType: 'Catálogo / Loja',
    rating: 5
  }
];
// Dados da Sua Bio
const estatisticas = [
  { value: "50+", label: "Projetos" },
  { value: "100%", label: "Exclusivos", isHighlight: true },
  { value: "Design", label: "Sob Medida" }
];

const minhasSolucoes = [

  {
    label: "Sites & Landing Pages",
    subtitle: "Páginas institucionais e de alta conversão sob medida",
    description:
      "Desenvolvimento de sites rápidos, responsivos e com design exclusivo para transmitir autoridade e transformar visitantes em clientes.",
    url: "https://wa.me/5541984940848?text=Olá!%20Gostaria%20de%20um%20orçamento%20para%20Site%20ou%20Landing%20Page.",
    ctaLabel: "Pedir Orçamento",
    iconClass: "fa-solid fa-laptop-code",
    variant: "secondary" as const,
  },
  {
    label: "Loja Digital em Revista",
    subtitle: "Catálogo interativo com checkout e pedido pronto no WhatsApp",
    description:
      "Apresente seus produtos em um formato editorial envolvente, com navegação visual, carrinho com checkout simples e envio automático do pedido formatado direto no seu WhatsApp.",
    url: "https://wa.me/5541984940848?text=Olá!%20Quero%20saber%20mais%20sobre%20a%20Loja%20Digital%20em%20formato%20de%20revista.",
    ctaLabel: "Quero na Minha Loja",
    secondaryUrl: "https://modelocatalogo.pages.dev/demo/moda/",
    secondaryLabel: "Ver Demonstração",
    iconClass: "fa-solid fa-book-open",
    badgeText: "Lançamento",
    variant: "accent" as const,
  },
  {
    label: "Minisites para Bio",
    subtitle: "Página exclusiva de links e apresentação para redes sociais",
    description:
      "Muito além de um agregador comum: uma página com a identidade visual da sua marca, apresentação profissional e botões estratégicos.",
    url: "https://wa.me/5541984940848?text=Olá!%20Quero%20um%20Minisite%20para%20Bio%20personalizado.",
    ctaLabel: "Quero o Meu",
    secondaryUrl: "https://minisites-bio.pages.dev/",
    secondaryLabel: "Ver Exemplos",
    iconClass: "fa-solid fa-mobile-screen-button",
    badgeText: "Popular",
    variant: "secondary" as const,
  },
  {
    label: "Foxped — Cardápio Digital",
    subtitle: "Sistema de pedidos automatizado direto no WhatsApp",
    description:
      "Cardápio ou catálogo interativo sem taxas por pedido. Seu cliente monta o carrinho e envia o pedido organizado direto para o seu WhatsApp.",
    url: "https://wa.me/5541984940848?text=Olá!%20Quero%20saber%20mais%20sobre%20o%20Foxped.",
    ctaLabel: "Falar no WhatsApp",
    secondaryUrl: "https://foxped.com.br",
    secondaryLabel: "Conhecer Sistema",
    iconClass: "fa-solid fa-utensils",
    variant: "accent" as const,
  },
  {
    label: "Hospedagem Hostinger (Com Desconto)",
    subtitle: "Garanta a melhor hospedagem para seu site com desconto exclusivo",
    description:
      "Contrate sua hospedagem com domínio grátis e certificado SSL usando meu link de indicação oficial para garantir desconto extra na assinatura.",
    url: "https://www.hostinger.com/br?REFERRALCODE=NZOJAQUELFVN",
    ctaLabel: "Resgatar Desconto",
    ctaIcon: "fa-solid fa-arrow-up-right-from-square",
    iconClass: "fa-solid fa-server",
    badgeText: "Cupom / Desconto",
    variant: "outline" as const,
  },
];

const socialLinks = [
  { platform: 'website' as const, url: 'https://jakdigitaldesign.com' },
  { platform: 'whatsapp' as const, url: 'https://wa.me/5541984940848' },
  { platform: 'instagram' as const, url: 'https://www.instagram.com/jak.digitaldesign/' },
];
---

<Layout title="Jak Digital Design | Design Web & Minisites Premium">
  <!-- Efeito de Luz / Glow de Fundo Geral -->
  <div class="fixed top-25 left-1/2 -translate-x-1/2 w-125 h-125 bg-radial from-accent/25 via-purple-dark/20 to-transparent blur-3xl pointer-events-none z-0"></div>

  <!-- CONTAINER CENTRALIZADO TIPO MOBILE CARD -->
  <div class="w-full min-h-screen flex items-center justify-center sm:py-8 px-0 sm:px-4 relative z-10 font-body bg-bg-dark text-gray-light">
    
    <main class="w-full max-w-md mx-auto bg-[#09050d] sm:rounded-[36px] overflow-hidden border border-purple-dark/30 shadow-2xl shadow-accent/10 flex flex-col justify-between min-h-screen sm:min-h-0">
      
      <div>
        <!-- Componente 1: Header + Manifesto + Redes -->
       <BioHeaderDark
        name="Jaqueline Souza Vidal"
        category="Desenvolvimento Web"
        badgeText="Web Design"
        avatarImg={avatarImg}
        logoImg={logo}
        socialLinks={socialLinks}
        manifestoText="Sites, lojas e catálogos digitais sob medida para encantar clientes e facilitar cada pedido no dia a dia."
        ctaButton={{
          label: "Solicitar Orçamento",
          url: "https://wa.me/5541984940848",
          iconClass: "fa-brands fa-whatsapp"
        }}
      />

        <!-- Componente 2: Métricas / Estatísticas -->
        <BioStatsDark stats={estatisticas} />

        <!-- Componente 3: Soluções / Links -->
        <BioLinksDark 
          sectionTitle="SERVIÇOS & SOLUÇÕES DIGITAIS"
          links={minhasSolucoes} 
        />

        <!-- Componente 4: Galeria Dupla (Sites & Minisites) -->
        <BioTabbedGallery 
          title="Projetos em Destaque"
          subtitle="Portfólio & Cases"
          
          cardSize="sm"
          speedSeconds={30}
        />
      </div>
            <TestimonialsCarousel
        sectionTag="Avaliações"
        title="O que dizem sobre o trabalho"
        testimonials={testimonials}
      />
      <FaqSection
      />
      <!-- Footer -->
      <BioFooterDark 
        logoImg={logo}
        brandName="Jak Digital Design"
        developerName="Jak Digital Design"
        developerUrl="https://jakdigitaldesign.com"
        showBackToTop={true}
      />

    </main>
  </div>
</Layout>