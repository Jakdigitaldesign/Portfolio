---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Importe sua foto/avatar de alta qualidade aqui
import avatarImg from '../assets/jak.webp'; 
---

<Layout title="Jak Digital Design | Design Web & Minisites Premium">
  <!-- Efeito de Luz / Glow de Fundo -->
  <div class="fixed top-[-100px] left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-radial from-accent/25 via-purple-dark/20 to-transparent blur-3xl pointer-events-none z-0"></div>

  <!-- CONTAINER CENTRALIZADO TIPO MOBILE CARD -->
  <div class="w-full min-h-screen flex items-center justify-center sm:py-8 px-0 sm:px-4 relative z-10 font-body bg-color-bg-dark text-color-gray-light">
    
    <main class="w-full max-w-md mx-auto bg-[#09050d] sm:rounded-[36px] overflow-hidden border border-purple-dark/30 shadow-2xl shadow-accent/10 flex flex-col justify-between">
      
      <div>
       <!-- 1. HERO BANNER DE TOPO (Foto Clara e Iluminada) -->
        <div class="relative w-full h-[320px] overflow-hidden flex flex-col justify-between p-6">
          
          <!-- Efeito de Luz (Glow) Roxa Atrás da Foto para dar Destaque -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[280px] h-[280px] bg-accent/30 rounded-full blur-3xl pointer-events-none z-0"></div>

          <!-- Imagem de Fundo (Foto Limpa e Clara) -->
          <div class="absolute inset-0 z-0">
            <Image 
              src={avatarImg} 
              alt="Jak Digital Design" 
              class="w-full h-full object-contain object-top" 
            />
            <!-- Gradient leve APENAS na parte inferior para leitura do texto -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#09050d] via-[#09050d]/20 to-transparent"></div>
          </div>

          <!-- Top Badges Flutuantes -->
          <div class="relative z-10 flex justify-between items-center">
            <span class="px-3 py-1 text-[10px] font-heading font-semibold uppercase tracking-widest text-color-purple-light bg-black/40 backdrop-blur-md rounded-full border border-accent/40">
              Web Design
            </span>
            <!-- Indicador Online -->
            <div class="flex items-center gap-1.5 px-2.5 py-1 bg-black/40 backdrop-blur-md rounded-full border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-[10px] font-medium text-emerald-400">Disponível</span>
            </div>
          </div>

          <!-- Nome do Estúdio na Capa (com sombra leve para legibilidade) -->
          <div class="relative z-10 mb-1">
            <h1 class="font-heading text-3xl font-bold text-white tracking-tight leading-none mb-1 drop-shadow-md">
              Jak Digital Design
            </h1>
            <p class="font-heading text-xs uppercase tracking-[0.2em] text-accent font-semibold drop-shadow">
              Desenvolvimento Web
            </p>
          </div>
        </div>

        <!-- 2. CORPO DO CARD (Fundo Escuro Elegante) -->
        <div class="p-6 pt-4 space-y-6">
          
          <!-- Manifesto / Frase Institucional -->
          <div class="p-4 rounded-xl bg-purple-dark/15 border-l-2 border-accent backdrop-blur-sm">
            <p class="font-heading italic text-sm text-color-purple-light/90 leading-relaxed">
              "Design estratégico e soluções digitais sob medida para elevar o posicionamento da sua marca no digital."
            </p>
          </div>

          <!-- Redes Sociais Rápidas -->
          <div class="flex gap-3 justify-center py-1">
            <!-- WhatsApp -->
            <a 
              href="https://wa.me/5541984940848" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="WhatsApp"
              class="w-10 h-10 rounded-full bg-purple-dark/30 border border-purple-dark/60 text-color-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a 
              href="https://www.instagram.com/jak.digitaldesign/" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="Instagram"
              class="w-10 h-10 rounded-full bg-purple-dark/30 border border-purple-dark/60 text-color-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a 
              href="https://www.linkedin.com/in/jaqueline-souza95/" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="LinkedIn"
              class="w-10 h-10 rounded-full bg-purple-dark/30 border border-purple-dark/60 text-color-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>

          <!-- 3. MINI ESTATÍSTICAS (Estilo Modelo "10+ Anos | 120 Projetos | 04 Prêmios") -->
          <div class="grid grid-cols-3 gap-2 py-3 border-y border-purple-dark/30 text-center">
            <div>
              <p class="font-heading font-bold text-lg text-white">50+</p>
              <p class="text-[10px] uppercase tracking-wider text-color-purple-light/70">Projetos</p>
            </div>
            <div class="border-x border-purple-dark/30">
              <p class="font-heading font-bold text-lg text-accent">100%</p>
              <p class="text-[10px] uppercase tracking-wider text-color-purple-light/70">Exclusivos</p>
            </div>
            <div>
              <p class="font-heading font-bold text-lg text-white">R$ 39,99</p>
              <p class="text-[10px] uppercase tracking-wider text-color-purple-light/70">A partir de</p>
            </div>
          </div>

          <!-- 4. SEÇÃO DE SOLUÇÕES & LINKS -->
          <div class="space-y-3">
            
            <p class="text-[11px] font-heading font-semibold uppercase tracking-[0.2em] text-accent/90 mb-1">
              // Soluções & Soluções Digitais
            </p>

            <!-- Link 1: Portfólio Destaque -->
            <a 
              href="https://jakdigitaldesign.com" 
              target="_blank"
              class="group flex items-center justify-between p-4 bg-gradient-to-r from-purple-dark/20 to-purple-dark/40 border border-accent/40 rounded-xl hover:border-accent hover:bg-purple-dark/60 hover:shadow-lg hover:shadow-accent/20 transition-all duration-300"
            >
              <div>
                <h3 class="font-heading font-semibold text-white text-sm group-hover:text-accent transition-colors">
                  Portfólio Oficial
                </h3>
                <p class="text-xs text-color-gray-light/70 mt-0.5">
                  Projetos de sites completos e branding
                </p>
              </div>
              <span class="text-accent group-hover:translate-x-1 transition-transform font-bold text-sm">→</span>
            </a>

            <!-- Link 2: Modelos de Minisites (O seu produto principal do post) -->
            <a 
              href="https://sites-bio.pages.dev" 
              target="_blank"
              class="group flex items-center justify-between p-4 bg-[#120a1c] border border-purple-dark/50 rounded-xl hover:border-accent hover:bg-purple-dark/30 hover:shadow-md transition-all duration-300"
            >
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-heading font-semibold text-white text-sm group-hover:text-accent transition-colors">
                    Modelos de Link na Bio
                  </h3>
                  <span class="text-[9px] px-1.5 py-0.5 bg-accent text-white font-bold rounded">OFERTA</span>
                </div>
                <p class="text-xs text-color-gray-light/70 mt-0.5">
                  Escolha seu modelo por apenas R$ 39,99/ano
                </p>
              </div>
              <span class="text-color-purple-light group-hover:text-accent group-hover:translate-x-1 transition-all text-sm">→</span>
            </a>

            <!-- Link 3: Cardápio Digital / Foxped -->
            <a 
              href="https://foxped.com.br" 
              target="_blank"
              class="group flex items-center justify-between p-4 bg-[#120a1c] border border-purple-dark/50 rounded-xl hover:border-accent hover:bg-purple-dark/30 transition-all duration-300"
            >
              <div>
                <h3 class="font-heading font-semibold text-white text-sm group-hover:text-accent transition-colors">
                  Foxped — Cardápio Digital
                </h3>
                <p class="text-xs text-color-gray-light/70 mt-0.5">
                  Sistema de pedidos integrado ao WhatsApp
                </p>
              </div>
              <span class="text-color-purple-light group-hover:text-accent group-hover:translate-x-1 transition-all text-sm">→</span>
            </a>

            <!-- Link 4: Orçamento Direto -->
            <a 
              href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento%20para%20um%20projeto." 
              target="_blank"
              class="group flex items-center justify-between p-4 bg-[#120a1c] border border-purple-dark/50 rounded-xl hover:border-accent hover:bg-purple-dark/30 transition-all duration-300"
            >
              <div>
                <h3 class="font-heading font-semibold text-white text-sm group-hover:text-accent transition-colors">
                  Solicitar Projeto Personalizado
                </h3>
                <p class="text-xs text-color-gray-light/70 mt-0.5">
                  Fale direto pelo WhatsApp
                </p>
              </div>
              <span class="text-color-purple-light group-hover:text-accent group-hover:translate-x-1 transition-all text-sm">→</span>
            </a>

          </div>

        </div>
      </div>

      <!-- FOOTER -->
      <footer class="p-6 text-center text-[11px] text-color-purple-light/50 border-t border-purple-dark/20">
        <p>© {new Date().getFullYear()} Jak Digital Design — Todos os direitos reservados</p>
      </footer>

    </main>
  </div>
</Layout>