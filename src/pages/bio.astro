---
import Layout from '../layouts/Layout.astro';
import BioHeaderDark from '../components/Bio/BioHeaderDark.astro';
import BioStatsDark from '../components/Bio/BioStatsDark.astro';
import BioLinksDark from '../components/Bio/BioLinksDark.astro';
import BioFooterDark from '../components/Bio/BioFooterDark.astro';

//imagens
import logo from '../assets/Logo.png';
import avatarImg from '../assets/jak.png';
import simboloImg from '../assets/simbolo.png';


// Dados da Sua Bio
const estatisticas = [
  { value: "50+", label: "Projetos" },
  { value: "100%", label: "Exclusivos", isHighlight: true },
  { value: "Design", label: "Sob Medida" }
];

const minhasSolucoes = [
  {
    label: "Meu Site Principal",
    subtitle: "Conheça meu portfólio completo e todos os serviços",
    url: "https://jakdigitaldesign.com", // Ajuste para a URL oficial do seu site
    iconClass: "fa-solid fa-globe",
    variant: "primary" as const,
    highlight: true,
  },
  {
    label: "Sites & Landing Pages",
    subtitle: "Páginas institucionais e de alta conversão sob medida",
    url: "https://wa.me/5541984940848?text=Olá!%20Gostaria%20de%20um%20orçamento%20para%20Site%20ou%20Landing%20Page.",
    iconClass: "fa-solid fa-laptop-code",
    variant: "secondary" as const,
  },
  {
    label: "Minisites para Bio",
    subtitle: "Página exclusiva de links e apresentação para redes sociais",
    url: "https://wa.me/5541984940848?text=Olá!%20Quero%20um%20Minisite%20para%20Bio%20personalizado.",
    iconClass: "fa-solid fa-mobile-screen-button",
    badgeText: "Popular",
    variant: "secondary" as const,
  },
  {
    label: "Foxped — Cardápio Digital",
    subtitle: "Sistema de pedidos automatizado direto no WhatsApp",
    url: "https://foxped.com.br",
    iconClass: "fa-solid fa-utensils",
    variant: "accent" as const,
  },
  
  {
    label: "Hospedagem Hostinger (Com Desconto)",
    subtitle: "Garanta a melhor hospedagem para seu site com desconto exclusivo",
    url: "https://www.hostinger.com/br?REFERRALCODE=NZOJAQUELFVN",
    iconClass: "fa-solid fa-server",
    badgeText: "Cupom / Desconto",
    variant: "outline" as const,
  }
];
const socialLinks = [
  { platform: 'website' as const, url: 'https://jakdigitaldesign.com' },
  { platform: 'whatsapp' as const, url: 'https://wa.me/5541984940848' },
  { platform: 'instagram' as const, url: 'https://www.instagram.com/jak.digitaldesign/' },
  { platform: 'linkedin' as const, url: 'https://www.linkedin.com/in/jaqueline-souza95/' }
];
---

<Layout title="Jak Digital Design | Design Web & Minisites Premium">
  <!-- Efeito de Luz / Glow de Fundo Geral -->
  <div class="fixed top-25 left-1/2 -translate-x-1/2 w-125 h-125 bg-radial from-accent/25 via-purple-dark/20 to-transparent blur-3xl pointer-events-none z-0"></div>

  <!-- CONTAINER CENTRALIZADO TIPO MOBILE CARD -->
  <div class="w-full min-h-screen flex items-center justify-center sm:py-8 px-0 sm:px-4 relative z-10 font-body bg-bg-dark text-gray-light">
    
    <main class="w-full max-w-md mx-auto bg-[#09050d] sm:rounded-[36px] overflow-hidden border border-purple-dark/30 shadow-2xl shadow-accent/10 flex flex-col justify-between min-h-screen sm:min-h-0">
      
      <div>
        <!-- Componente 1: Header + Manifesto + Redes -->
        <BioHeaderDark
          name="Jak Digital Design"
          category="Desenvolvimento Web"
          badgeText="Web Design"
          avatarImg={avatarImg}
          logoImg={simboloImg}
          socialLinks={socialLinks}
          manifestoText="Design estratégico e soluções digitais sob medida para elevar o posicionamento da sua marca no digital."
        />

        <!-- Componente 2: Métricas / Estatísticas -->
        <BioStatsDark stats={estatisticas} />

        <!-- Componente 3: Soluções / Links -->
        <BioLinksDark 
          sectionTitle="// Soluções & Soluções Digitais"
          links={minhasSolucoes} 
        />
        </div>
        

      <!-- Footer -->
      <BioFooterDark 
        logoImg={logo}
        brandName="Jak Digital Design"
        developerName="Jak Digital Design"
        developerUrl="https://jakdigitaldesign.com"
        showBackToTop={true}
      />

    </main>
  </div>
</Layout>