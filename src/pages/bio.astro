---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Substitua pelo caminho correto da sua foto/logo de avatar
import avatarImg from '../assets/jak.webp'; 
---

<Layout title="Jak Digital Design | Links & Contato">
  <!-- EFEITO DE LUZ DE FUNDO (GLOW BACKGROUND) -->
  <div class="fixed top-[-150px] left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-radial from-accent/20 via-purple-dark/10 to-transparent blur-3xl pointer-events-none z-0"></div>

  <!-- CONTAINER CENTRALIZADO (Impede de ficar Full Width em Desktop) -->
  <!-- max-w-md aqui garante que o card nunca alargue além de ~28rem, mesmo em telas grandes -->
  <div class="w-full min-h-screen flex items-center justify-center px-4 py-8 relative z-10">
    
    <main
      class="w-full max-w-md mx-auto flex flex-col justify-between items-center min-h-[85vh]"
      style="max-width: 28rem; margin-left: auto; margin-right: auto;"
    >
      
      <div class="w-full flex flex-col items-center">
        
        <!-- CABEÇALHO / PERFIL -->
        <header class="text-center mb-6 w-full flex flex-col items-center">
          <!-- AVATAR COM DIMENSÕES TRAVADAS -->
          <div class="relative w-24 h-24 shrink-0 mb-3.5">
            <Image
              src={avatarImg}
              alt="Jak Digital Design"
              width={192}
              height={192}
              class="w-24 h-24 rounded-full object-cover object-top border-2 border-accent/50 shadow-lg shadow-accent/30"
            />
            <!-- Badge de Status Ativo -->
            <span 
              class="absolute bottom-1 right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-bg-dark rounded-full"
              title="Disponível para novos projetos"
            ></span>
          </div>

          <h1 class="font-heading font-extrabold text-2xl text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-100 to-gray-400 mb-1">
            Jak Digital Design
          </h1>
          <p class="font-body text-sm text-gray-light/80 mb-4 text-center">
            Desenvolvimento Web & Soluções Digitais
          </p>

          <!-- REDES SOCIAIS RÁPIDAS -->
          <div class="flex gap-3 justify-center">
            <!-- WhatsApp -->
            <a
              href="https://wa.me/5541984940848"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
              class="w-10 h-10 rounded-full bg-purple-dark/20 border border-purple-dark/60 text-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="https://instagram.com/seuusuario"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="w-10 h-10 rounded-full bg-purple-dark/20 border border-purple-dark/60 text-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://linkedin.com/in/seuusuario"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="w-10 h-10 rounded-full bg-purple-dark/20 border border-purple-dark/60 text-gray-light flex items-center justify-center hover:text-white hover:border-accent hover:bg-accent/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          </div>
        </header>
 <!-- LISTA DE LINKS PRINCIPAIS -->
        <section class="w-full space-y-3">
          
          <!-- Link 1: Portfólio (Destaque Principal) -->
          <a
            href="https://jakdigitaldesign.com"
            target="_blank"
            class="group relative flex items-center p-4.5 bg-gradient-to-r from-purple-dark/30 to-bg-dark/80 backdrop-blur-md border border-accent/40 rounded-2xl hover:border-accent hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-accent/20 border border-accent/30 text-accent flex items-center justify-center mr-4 shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
            </div>
            <div class="flex flex-col flex-grow">
              <span class="font-heading font-semibold text-white text-base leading-tight mb-0.5">
                Portfólio Oficial
              </span>
              <span class="font-body text-xs text-gray-light/80">
                Conheça nossos projetos e trabalhos desenvolvidos
              </span>
            </div>
            <span class="text-gray-light group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-2">
              →
            </span>
          </a>

          <!-- Link 2: Foxped (Badge reduzida) -->
          <a
            href="https://foxped.com.br"
            target="_blank"
            class="group flex flex-col p-3.5 bg-gradient-to-r from-bg-dark/80 to-purple-dark/20 backdrop-blur-md border border-purple-dark/50 rounded-2xl hover:border-accent hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 transition-all duration-300"
          >
            

            <div class="flex items-center w-full">
              <div class="w-10 h-10 rounded-xl bg-purple-dark/40 border border-purple-dark/60 text-accent flex items-center justify-center mr-3.5 shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="flex flex-col flex-grow">
                <span class="font-heading font-semibold text-white text-base leading-tight mb-0.5">
                  Foxped - Cardápio Digital
                </span>
                <span class="font-body text-xs text-gray-light/80">
                  Sistema interativo de pedidos via WhatsApp
                </span>
              </div>
              <span class="text-gray-light group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-2">
                →
              </span>
            </div>
          </a>

          <!-- Link 3: Modelos de Minisites -->
          <a
            href="https://minisites.pages.dev"
            target="_blank"
            class="group flex items-center p-3.5 bg-bg-dark/60 backdrop-blur-md border border-purple-dark/40 rounded-2xl hover:border-accent hover:bg-purple-dark/20 hover:-translate-y-0.5 transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-purple-dark/30 border border-purple-dark/50 text-accent flex items-center justify-center mr-3.5 shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
              </svg>
            </div>
            <div class="flex flex-col flex-grow">
              <span class="font-heading font-semibold text-white text-base leading-tight mb-0.5">
                Modelos de Link na Bio
              </span>
              <span class="font-body text-xs text-gray-light/80">
                Escolha um layout para seu negócio a partir de R$ 39,99
              </span>
            </div>
            <span class="text-gray-light group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-2">
              →
            </span>
          </a>

          <!-- Link 4: Orçamentos -->
          <a
            href="https://wa.me/5541984940848?text=Ol%C3%A1!%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento%20para%20um%20projeto."
            target="_blank"
            class="group flex items-center p-3.5 bg-bg-dark/60 backdrop-blur-md border border-purple-dark/40 rounded-2xl hover:border-accent hover:bg-purple-dark/20 hover:-translate-y-0.5 transition-all duration-300"
          >
            <div class="w-10 h-10 rounded-xl bg-purple-dark/30 border border-purple-dark/50 text-accent flex items-center justify-center mr-3.5 shrink-0 group-hover:bg-accent group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
            </div>
            <div class="flex flex-col flex-grow">
              <span class="font-heading font-semibold text-white text-base leading-tight mb-0.5">
                Solicitar Orçamento
              </span>
              <span class="font-body text-xs text-gray-light/80">
                Fale via WhatsApp para projetos sob medida
              </span>
            </div>
            <span class="text-gray-light group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 shrink-0 ml-2">
              →
            </span>
          </a>

        </section>
        
      </div>

      <!-- FOOTER -->
      <footer class="mt-12 text-center text-xs text-gray-light/60 font-body">
  <p>© {new Date().getFullYear()} JAK Digital Design — Todos os direitos reservados</p>
</footer>
    </main>
  </div>
</Layout>