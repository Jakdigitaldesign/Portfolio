---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contato | Jak Digital Design">
  <Header />

  <main class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- CABEÇALHO -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl text-white mb-4">
          Vamos iniciar seu <span class="text-accent">projeto?</span>
        </h1>
        <p class="font-body text-gray-light text-lg">
          Preencha o formulário ou entre em contato direto pelos nossos canais. Respondo em até 2 horas em horário comercial!
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- COLUNA 1: INFORMAÇÕES DE CONTATO -->
        <div class="lg:col-span-5 space-y-8 bg-purple-dark/20 border border-purple-dark/50 p-8 rounded-3xl backdrop-blur-sm">
          <div>
            <h2 class="font-heading font-bold text-2xl text-white mb-2">Canais Diretos</h2>
            <p class="font-body text-gray-light text-sm">
              Prefere uma conversa sem formalidades? Escolha a melhor opção abaixo:
            </p>
          </div>

          <div class="space-y-6">
            <!-- WhatsApp -->
            <a 
              href="https://wa.me/5541984940848" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 group p-4 rounded-2xl bg-purple-dark/30 border border-purple-dark/60 hover:border-accent hover:bg-accent/10 transition-all duration-300"
            >
              <div class="p-3 rounded-xl bg-accent text-white group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.097-4.437l.432.257c1.52.903 3.267 1.38 5.048 1.381 5.283 0 9.581-4.298 9.584-9.581.002-2.56-.992-4.966-2.802-6.777-1.81-1.81-4.215-2.806-6.776-2.808-5.285 0-9.582 4.299-9.584 9.582-.001 1.867.538 3.69 1.558 5.275l.282.438-1.031 3.766 3.85-1.009z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-accent mb-0.5">WhatsApp</span>
                <span class="font-heading font-bold text-white text-base">Conversar no WhatsApp</span>
              </div>
            </a>

            <!-- E-mail -->
            <a 
              href="mailto:contato@jakdigitaldesign.com" 
              class="flex items-center gap-4 group p-4 rounded-2xl bg-purple-dark/30 border border-purple-dark/60 hover:border-accent hover:bg-accent/10 transition-all duration-300"
            >
              <div class="p-3 rounded-xl bg-accent text-white group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-accent mb-0.5">E-mail</span>
                <span class="font-heading font-bold text-white text-base">contato@jakdigitaldesign.com</span>
              </div>
            </a>

            <!-- Localização -->
            <div class="flex items-center gap-4 p-4 rounded-2xl bg-purple-dark/30 border border-purple-dark/60">
              <div class="p-3 rounded-xl bg-purple-dark text-accent">
                <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-accent mb-0.5">Localização</span>
                <span class="font-heading font-semibold text-white text-sm">São José dos Pinhais, PR (Atendimento Brasil)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUNA 2: FORMULÁRIO DE MENSAGEM -->
        <div class="lg:col-span-7 bg-[#050505] border border-purple-dark/40 p-8 sm:p-10 rounded-3xl shadow-2xl">
          <form action="https://formspree.io/f/moeqlgwo" method="POST" class="space-y-6">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Nome -->
              <div>
                <label for="name" class="block text-sm font-semibold text-white mb-2">Seu Nome</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Ex: Maria Silva"
                  class="w-full bg-purple-dark/20 border border-purple-dark/60 rounded-xl px-4 py-3 text-white placeholder-gray-light/50 focus:outline-none focus:border-accent transition-colors"
                />
              </div>

              <!-- WhatsApp/Telefone -->
              <div>
                <label for="phone" class="block text-sm font-semibold text-white mb-2">WhatsApp / Telefone</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  placeholder="(00) 00000-0000"
                  class="w-full bg-purple-dark/20 border border-purple-dark/60 rounded-xl px-4 py-3 text-white placeholder-gray-light/50 focus:outline-none focus:border-accent transition-colors"
                />
              </div>
            </div>

            <!-- E-mail -->
            <div>
              <label for="email" class="block text-sm font-semibold text-white mb-2">E-mail Profissional</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="seuemail@empresa.com"
                class="w-full bg-purple-dark/20 border border-purple-dark/60 rounded-xl px-4 py-3 text-white placeholder-gray-light/50 focus:outline-none focus:border-accent transition-colors"
              />
            </div>

            <!-- Tipo de Projeto -->
            <div>
              <label for="project" class="block text-sm font-semibold text-white mb-2">Qual seu objetivo?</label>
              <select 
                id="project" 
                name="project" 
                class="w-full bg-[#0d0914] border border-purple-dark/60 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
              >
                <option value="Landing Page">Landing Page de Alta Conversão</option>
                <option value="Site Institucional">Site Institucional Completo</option>
                <option value="Loja Virtual">Loja Virtual / E-commerce</option>
                <option value="Outro">Outro tipo de projeto</option>
              </select>
            </div>

            <!-- Mensagem -->
            <div>
              <label for="message" class="block text-sm font-semibold text-white mb-2">Detalhes do Projeto</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Conte um pouco sobre sua empresa ou ideia..."
                class="w-full bg-purple-dark/20 border border-purple-dark/60 rounded-xl px-4 py-3 text-white placeholder-gray-light/50 focus:outline-none focus:border-accent transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Botão Enviar -->
            <button 
              type="submit" 
              class="w-full bg-accent hover:bg-accent/90 text-white font-heading font-bold py-4 rounded-xl shadow-lg shadow-accent/25 transition-all duration-300 hover:scale-[1.01]"
            >
              Enviar Mensagem
            </button>

          </form>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>