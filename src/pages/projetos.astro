---
// src/pages/projetos.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Galeria from '../components/Galeria.astro'; 
import Footer from '../components/Footer.astro';


const categories = ['Todos','Sites', 'SaaS / Lojas', ];
---

<Layout title="Portfólio & Projetos | Seus Serviços Digitais">
  <Header />

  <main class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- BOTÕES DE FILTRO -->
      

   <Galeria/>

    </div>
  </main>
  <Footer/>
</Layout>

<!-- SCRIPT DE FILTRAGEM -->
<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedFilter = btn.getAttribute('data-filter');

      // Atualiza o estilo visual dos botões
      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent', 'border-accent', 'text-white', 'shadow-lg', 'shadow-accent/25');
        b.classList.add('bg-purple-dark/20', 'border-purple-dark/60', 'text-gray-light');
      });

      btn.classList.remove('bg-purple-dark/20', 'border-purple-dark/60', 'text-gray-light');
      btn.classList.add('bg-accent', 'border-accent', 'text-white', 'shadow-lg', 'shadow-accent/25');

      // Oculta/Exibe os cards
      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');

        if (selectedFilter === 'Todos' || itemCategory === selectedFilter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>